---
import { STUDIOS } from '../data/calendar-studios';

/**
 * The interstitial "what is this place" card. Rebuilt from the deck rather than
 * reused as art, because the deck's version is out of date: it lists eight
 * services when there are now eleven studios, and it gives the old Wallingford
 * address alongside a Gas Works Park map.
 *
 * Where the deck had the map, this has a QR to the interest form. At a market
 * nobody is navigating to the building from the screen - they are deciding
 * whether to give you their email - so the scannable thing earns the space that
 * a map cannot.
 */
const left = STUDIOS.slice(0, Math.ceil(STUDIOS.length / 2));
const right = STUDIOS.slice(Math.ceil(STUDIOS.length / 2));
---

<div class="slide bg-white" data-type="brand">
  <div class="absolute inset-0 flex">
    <!-- left: who we are + what's here -->
    <section class="flex w-[1105px] shrink-0 flex-col justify-center px-[80px] py-[54px]">
      <img src="/brand/wordmark.png" alt="Seattle Makers" class="h-[176px] w-auto self-start" />
      <p class="mt-[16px] text-[52px] leading-none font-black text-sm-green">
        we help you make cool stuff!
      </p>

      <div class="mt-[46px] grid grid-cols-2 gap-x-[54px] gap-y-[24px]">
        {
          [left, right].map((col) => (
            <ul class="flex flex-col gap-[24px]">
              {col.map((s) => (
                <li class="flex items-center gap-[20px]">
                  <img src={s.icon} alt="" class="h-[62px] w-[62px] shrink-0" />
                  <span class="text-[40px] leading-none font-bold text-sm-ink">{s.name}</span>
                </li>
              ))}
            </ul>
          ))
        }
      </div>

      <p class="mt-[44px] text-[31px] leading-[1.35] text-sm-ink">
        certifications | courses | teambuilding | meetups<br />.. and much more!
      </p>
    </section>

    <!-- right: how to find us -->
    <section
      class="flex flex-1 flex-col items-center justify-center border-l-2 border-neutral-200 px-[64px] py-[46px]"
    >
      <p class="text-[52px] leading-none font-black text-sm-ink">
        become a <span class="tracking-[0.02em]">MEMBER</span>
      </p>

      <div class="mt-[26px] flex items-center gap-[34px] text-sm-green">
        <!-- facebook -->
        <svg viewBox="0 0 32 32" class="h-[52px] w-[52px]" fill="currentColor" aria-hidden="true">
          <path d="M19.5 11.2h3.3V6.6c-.6-.1-2.5-.3-4.8-.3-4.7 0-7 2.9-7 7.1v3.4H7.4v5.2H11v13h5.3v-13h4l.6-5.2h-4.6v-2.9c0-1.5.4-2.7 2.2-2.7z"></path>
        </svg>
        <!-- instagram -->
        <svg viewBox="0 0 32 32" class="h-[52px] w-[52px]" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true">
          <rect x="4.2" y="4.2" width="23.6" height="23.6" rx="7"></rect>
          <circle cx="16" cy="16" r="6"></circle>
          <circle cx="23.2" cy="8.8" r="1.7" fill="currentColor" stroke="none"></circle>
        </svg>
        <!-- x / twitter -->
        <svg viewBox="0 0 32 32" class="h-[52px] w-[52px]" fill="currentColor" aria-hidden="true">
          <path d="M18.9 14.1 28.4 3h-2.3l-8.2 9.6L11.3 3H3.6l9.9 14.5L3.6 29h2.3l8.7-10.1L21.5 29h7.7zM15.7 17.8l-1-1.4L6.7 4.7h3.5l6.5 9.3 1 1.4 8.4 12h-3.5z"></path>
        </svg>
        <!-- youtube -->
        <svg viewBox="0 0 32 32" class="h-[52px] w-[52px]" fill="currentColor" aria-hidden="true">
          <path d="M30.4 10.2a3.8 3.8 0 0 0-2.7-2.7C25.3 6.9 16 6.9 16 6.9s-9.3 0-11.7.6a3.8 3.8 0 0 0-2.7 2.7C1 12.6 1 16 1 16s0 3.4.6 5.8a3.8 3.8 0 0 0 2.7 2.7c2.4.6 11.7.6 11.7.6s9.3 0 11.7-.6a3.8 3.8 0 0 0 2.7-2.7c.6-2.4.6-5.8.6-5.8s0-3.4-.6-5.8M13 20.5v-9l7.8 4.5z"></path>
        </svg>
        <!-- meetup -->
        <svg viewBox="0 0 32 32" class="h-[52px] w-[52px]" fill="currentColor" aria-hidden="true">
          <path d="M3 22.6c0-.9.3-1.9.8-3l3.4-7.3c.7-1.6 1.9-2.5 3.3-2.5 1.2 0 2 .7 2 1.9 0 .5-.1 1-.4 1.7l-2.6 5.8c-.1.3-.2.5-.2.7 0 .4.3.6.7.6.6 0 1.1-.4 1.5-1.3l3-6.5c.8-1.9 2.1-2.9 3.7-2.9 1.3 0 2.1.7 2.1 1.9 0 .5-.1 1-.4 1.7l-2.6 5.8c-.1.3-.2.5-.2.7 0 .4.3.6.7.6.6 0 1.1-.4 1.6-1.4l2.8-6c.8-1.7 1.9-2.6 3.3-2.6 1.3 0 2.2.8 2.2 2 0 .6-.2 1.3-.6 2.1l-3.2 6.8c-.2.4-.3.7-.3 1 0 .5.3.8.9.8.4 0 .8-.1 1.2-.4l.5 1.2c-.9.7-2 1.1-3.1 1.1-1.7 0-2.8-.9-2.8-2.3 0-.5.1-1.1.4-1.8l1-2.2-1.4 2.9c-1 2.1-2.3 3.1-4 3.1-1.6 0-2.6-.9-2.6-2.3 0-.4.1-.9.3-1.4l1.1-2.5-1.3 2.8c-1 2.1-2.3 3.2-4 3.2-1.7 0-2.8-1-2.8-2.5z"></path>
        </svg>
      </div>

      <div class="mt-[28px] flex flex-col items-center">
        <div class="border-[5px] border-sm-ink bg-white p-[22px]">
          <img src="/brand/qr-interest.svg" alt="" class="block h-[352px] w-[352px]" />
        </div>
        <p class="mt-[18px] text-[38px] leading-none font-black text-sm-green">
          scan to get in touch
        </p>
      </div>

      <div class="mt-[26px] text-center">
        <p class="text-[42px] leading-none font-black text-sm-ink">
          SeattleMakers.org <span class="text-[#f07f2a]">&#9664;</span>
          <span class="text-[#f07f2a]">take a tour!</span>
        </p>
        <p class="mt-[14px] text-[32px] leading-[1.3] text-sm-ink">
          (206) 659-1726<br />3012 16th Ave W, Seattle WA 98119
        </p>
      </div>
    </section>
  </div>
</div>
