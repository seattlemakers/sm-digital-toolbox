---
import Base from '../layouts/Base.astro';
import { SHEETS, STOCKS, perSheet } from '../data/labelSheets';
import { toolById, pageTitle } from '../data/tools';

/** Name, title, description and the subtitle under the heading all come from
    data/tools.ts, so this page and its card on the index say the same thing. */
const TOOL = toolById('labels');

/**
 * Label sheets.
 *
 * The sheet is positioned absolutely from the physical page corner, in inches,
 * because the die-cut does not move: a label has to land exactly where the
 * template puts it. That means `@page { margin: 0 }` and no reliance on flow
 * layout anywhere inside the page.
 */
const stocks = STOCKS.map((s) => ({
  stock: s,
  variants: SHEETS.filter((x) => x.stock === s),
}));
---

<Base
  title={pageTitle(TOOL)}
  description={TOOL.blurb}
  bodyClass="lb-page"
  shellWidth="84rem"
>
  <div class="lb-layout">
    {/* Wrapper so the sidebar reads as one column on a wide screen. Below the
        breakpoint it becomes display:contents, which drops it out of the box
        tree and lets the fields, the sheet and the Print button be ordered
        independently - preview above the button. */}
    <div class="lb-col no-print">
      <a class="sm-back lb-crumb" href="/">← All tools</a>
      <aside class="lb-editor">
      {/* No back link and no "seattle makers" eyebrow: the masthead above
          carries both, and repeating them here was the page saying its own
          name twice. */}
      <header class="sm-hero lb-head">
        <h1>{TOOL.name}</h1>
        <p class="lb-sub">{TOOL.blurb}</p>
      </header>

      <h2 class="lb-group">Sheet</h2>

      <fieldset class="lb-field">
        <legend>Stock</legend>
        <div class="lb-seg lb-seg-wrap" id="f-stock">
          {
            stocks.map(({ stock, variants }) => (
              <button type="button" data-stock={stock} aria-pressed={stock === '4x2.5'}>
                {stock.replace('x', ' × ')}in
                <i>{perSheet(variants[0]!)} per sheet</i>
              </button>
            ))
          }
        </div>
      </fieldset>

      <fieldset class="lb-field" id="f-dir-wrap">
        <legend>Content runs</legend>
        <div class="lb-seg" id="f-dir">
          <button type="button" data-dir="horizontal" aria-pressed="true">Across<i>wide label</i></button>
          <button type="button" data-dir="vertical" aria-pressed="false">Upright<i>tall label</i></button>
        </div>
      </fieldset>

      <h2 class="lb-group">Label</h2>

      <fieldset class="lb-field">
        <legend>Text</legend>
        <div class="lb-seg" id="f-mode">
          <button type="button" data-mode="same" aria-pressed="true">Same<i>on every label</i></button>
          <button type="button" data-mode="each" aria-pressed="false">Per label<i>each its own</i></button>
        </div>
      </fieldset>
      <p id="f-editing" class="lb-editing" hidden>
        Editing label <b id="f-editing-num">1</b> · click another on the sheet to edit it
      </p>

      {/* Plain text on purpose. A label title is one short phrase; bold and
          italics do nothing for it when it is already the largest, heaviest
          thing on the label, and a line break only invites the copy to grow. */}
      <label class="lb-field">
        <span>Title</span>
        <input id="f-title" type="text" maxlength="60" value="Woodshop" placeholder="Woodshop" />
      </label>

      <div class="lb-field">
        <span>Subtitle <i>optional</i></span>
        {/* Quill mounts here and supplies its own toolbar. */}
        <div class="lb-editor-shell">
          <div id="f-sub-toolbar"></div>
          <div id="f-sub"></div>
        </div>
      </div>

      <fieldset class="lb-field">
        <legend>Align</legend>
        <div class="lb-seg" id="f-align">
          <button type="button" data-align="auto" aria-pressed="true">Auto</button>
          <button type="button" data-align="left" aria-pressed="false">Left</button>
          <button type="button" data-align="center" aria-pressed="false">Center</button>
        </div>
      </fieldset>


      <label class="lb-field">
        <span>QR link <i>optional</i></span>
        <input
          id="f-url"
          type="text"
          inputmode="url"
          autocomplete="off"
          spellcheck="false"
          placeholder="seattlemakers.org/interest"
        />
      </label>
      <p id="f-url-note" class="lb-note" hidden></p>

      <p id="warn" class="lb-warn" hidden></p>

      <h2 class="lb-group">Printing</h2>
      <p id="f-pick-note" class="lb-note">
        Click a position on the sheet to print it. Skip any already peeled off.
      </p>
      <div class="lb-picks">
        <button type="button" id="f-all" class="lb-mini">All</button>
        <button type="button" id="f-none" class="lb-mini">Clear</button>
        <span id="f-count" class="lb-count">—</span>
      </div>

      </aside>

      <div class="lb-actions">
        <button id="f-print" type="button" class="lb-print">Print</button>
        <p class="lb-hint">
          Load the sheet <b>face down, top edge towards you</b>.
        </p>
        <p class="lb-hint">
          Check the print dialog each time — no headers or footers, margins off, scale at 100%. The labels only line up at true size.
        </p>
      </div>
    </div>

    <div class="lb-preview">
      <div class="lb-bar no-print">
        <span id="pv-sheet" class="pv-sheet">—</span>
        <span id="pv-label" class="pv-label">—</span>
      </div>
      <div id="preview-host">
        <div id="page"><div id="grid"></div></div>
      </div>
    </div>
  </div>

  <template id="label-tpl">
    <div class="lb-cell">
      <span class="lb-num no-print" aria-hidden="true"></span>
      <div class="lb-inner">
        <div class="lb-qr"></div>
        <div class="lb-text">
          <p class="lb-title"></p>
          <p class="lb-subtitle"></p>
        </div>
      </div>
    </div>
  </template>
</Base>

{/* Global, not scoped: the QR svg is injected with innerHTML and cloned, so it
    never receives Astro's scoped-style attribute. */}
<style is:global>
  /* ================================================== the physical sheet === */

  /* Margin 0, because the grid is positioned from the page corner in absolute
     inches. Anything else would put the ink somewhere the die-cut is not. */
  @page {
    size: letter portrait;
    margin: 0;
  }

  #page {
    position: relative;
    width: var(--page-w, 8.5in);
    /* the sheet is portrait in every mode; only the content ever turns */
    height: var(--page-h, 11in);
    background: #fff;
    color: #000;
    overflow: hidden;
  }

  #grid {
    position: absolute;
    inset: 0;
  }

  .lb-cell {
    position: absolute;
    overflow: hidden;
  }
  /* Left by default: the code, title and subtitle all start on the same
     vertical line, at every size and in both flows. Centring moves all three
     together rather than just the words. */
  .lb-cell[data-align='center'] .lb-inner {
    align-items: center;
  }
  .lb-cell[data-align='center'][data-flow='row'] .lb-inner {
    justify-content: flex-start;
  }
  .lb-cell[data-align='center'] .lb-text {
    text-align: center;
  }
  /* Everything hangs off one left margin, at every size and in both flows: the
     code, the title and the subtitle all start on the same vertical line. */
  .lb-inner {
    width: 100%;
    height: 100%;
    padding: var(--pad-y) var(--pad-x);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: var(--gap);
    text-align: left;
    overflow: hidden;
    overflow-wrap: break-word;
  }
  /* A wide label reads better with the code beside the words; a tall one stacks. */
  .lb-cell[data-flow='row'] .lb-inner {
    flex-direction: row;
    /* Vertically centered as a pair, but still flush left. */
    align-items: center;
  }
  .lb-cell[data-flow='column'] .lb-inner {
    flex-direction: column;
  }
  /* In a column the main axis is vertical, so a growing text box eats all the
     leftover height and pins the code to the top - which read as "not centered".
     The pair should size to its content and let justify-content center it. */
  .lb-cell[data-flow='column'] .lb-text {
    flex: 0 0 auto;
  }

  /* Upright: the same die-cut rectangle, with the content turned a quarter turn
     inside it. A w x h box rotated 90deg occupies h x w, which is the rectangle,
     so the two always agree. */
  .lb-cell[data-rot='1'] .lb-inner {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--rot-w);
    height: var(--rot-h);
    transform: translate(-50%, -50%) rotate(90deg);
  }

  /* width:100% is load-bearing, not decoration. Without it, a column-flow flex
     item sizes to its own content, so the title box grows to the text's natural
     width and scrollWidth can never exceed clientWidth - the auto-fit then has
     nothing to measure and the words run off the label. */
  .lb-text {
    flex: 1 1 auto;
    width: 100%;
    min-width: 0;
    /* Glyphs paint a little wider than the advance width scrollWidth measures,
       so a line that "fits" can still lay a few thousandths of an inch of ink
       past its box. This inset gives the side bearings somewhere to go. */
    padding-right: 0.02in;
    text-align: left;
  }
  /* Typed newlines are real newlines on the label - subtitle only. */
  .lb-subtitle {
    white-space: pre-wrap;
  }
  /* :empty misses a field holding only a <br>, so emptiness is decided in the
     script and flagged with a class. */
  .lb-title.is-empty,
  .lb-subtitle.is-empty {
    display: none;
  }
  /* Never break a title mid-word. That makes an oversized title *overflow*
     instead of silently hyphenating itself, which is what the script measures
     to decide how far to shrink. */
  .lb-title {
    overflow-wrap: normal;
    font-size: var(--title);
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: -0.02em;
    /* pretty, not balance: balance evens the line lengths, which fights a hard
       left margin. This only pulls up widows. */
    text-wrap: pretty;
  }
  .lb-subtitle {
    margin-top: 0.28em;
    font-size: var(--sub);
    font-weight: 400;
    line-height: 1.25;
    text-wrap: pretty;
  }

  /* Markers drawn by hand rather than list-style. Two reasons: the gap after a
     native marker is not controllable and comes out far too wide at label
     sizes, and a marker inside the text flow is the only kind that survives
     being centered - a hanging indent needs a left edge to hang from. */
  .lb-subtitle ul,
  .lb-subtitle ol {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .lb-subtitle ol {
    counter-reset: lb-item;
  }
  .lb-subtitle li {
    margin-top: 0.18em;
  }
  .lb-subtitle li:first-child {
    margin-top: 0;
  }
  .lb-subtitle ul li::before {
    content: '\2022';
    margin-right: 0.45em;
  }
  .lb-subtitle ol li::before {
    counter-increment: lb-item;
    content: counter(lb-item) '.';
    margin-right: 0.4em;
    font-variant-numeric: tabular-nums;
  }
  /* System monospace: always present, prints fine, and nothing to self-host. */
  .lb-subtitle code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    /* monospace runs wide and tall against Figtree at the same nominal size */
    font-size: 0.92em;
    padding: 0.1em 0.32em;
    border-radius: 0.3em;
    background: #e9e9e9;
    /* Browsers do not print backgrounds unless the viewer ticks "Background
       graphics", so the box would show on screen and vanish on paper. This
       forces it for this element only - the rest of the sheet stays ink-free
       and photocopy-friendly. */
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
    /* so a code span broken across two lines gets a box on each */
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .lb-qr {
    flex: none;
    width: var(--qr);
    height: var(--qr);
  }
  /* Row flow puts the code against the label's left margin, so that is the edge
     where its built-in quiet zone shows up as a doubled gap. Pull the box out
     by the quiet zone so the ink lands on the padding line. */
  .lb-cell[data-flow='row'] .lb-qr {
    margin-left: calc(var(--quiet-pull, 0in) * -1);
  }
  .lb-qr:empty {
    display: none;
  }
  .lb-qr svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* ========================================================= screen only === */

  @media screen {
    /* crispEdges is baked into the encoder's svg. Right at 600dpi, wrong in a
       scaled preview where it makes module rows look uneven. */
    .lb-qr svg {
      shape-rendering: geometricPrecision;
    }

    /* Flat mist, not the dotted workbench grid this used to have. The texture
       was a nice cue and it is a texture nothing else on the site or on
       seattlemakers.org uses, which made this page the odd one out. */
    body.lb-page {
      background-color: var(--color-sm-mist);
    }

    .lb-layout {
      display: flex;
      align-items: flex-start;
      gap: 2rem;
      max-width: 84rem;
      margin: 0 auto;
      padding: 2rem 1.5rem 4rem;
    }
    .lb-preview {
      flex: 1 1 auto;
      min-width: 0;
    }
    .lb-col {
      position: sticky;
      /* Plain again: there is no sticky masthead to clear any more, and
         --sm-bar-h went with it. Left as a calc() referencing a variable that
         no longer exists, this resolved to an invalid value and sticky
         silently fell back to static. */
      top: 2rem;
      flex: 0 0 22rem;
      width: 22rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    @media (max-width: 66rem) {
      .lb-layout {
        flex-direction: column;
        /* stretch, not the flex-start inherited from the two-column layout:
           in a column container align-items governs *width*, and flex-start
           makes each child size to its own content - which left the preview
           816px wide inside a 345px window, overflowing instead of scaling. */
        align-items: stretch;
      }
      /* Out of the box tree, so its children become flex items of .lb-layout
         and can be ordered around the sheet. */
      .lb-col {
        display: contents;
      }
      .lb-editor {
        position: static !important;
        width: 100% !important;
        order: 1;
      }
      /* The sheet belongs above the button you press to commit it to stock. */
      .lb-preview {
        width: 100%;
        order: 2;
      }
      .lb-actions {
        order: 3;
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
    }

    #preview-host {
      position: relative;
    }
    #page {
      transform: scale(var(--preview-scale, 1));
      transform-origin: top left;
      border-radius: 2px;
      box-shadow:
        0 1px 2px rgb(0 0 0 / 0.16),
        0 12px 34px rgb(0 0 0 / 0.13);
    }

    /* Three states, and they have to be tellable apart at a glance, because
       getting this wrong wastes a sheet of stock:
         printing  - white, solid green edge, content at full strength
         empty     - grey, dashed edge, content ghosted so you can still picture it
         hover     - green wash, whichever state it is in */
    .lb-cell {
      cursor: pointer;
      outline: 1px dashed rgb(0 0 0 / 0.2);
      outline-offset: -1px;
      transition:
        background-color 120ms ease,
        outline-color 120ms ease;
    }
    .lb-cell[data-on='1'] {
      background: #fff;
      outline: 2px solid var(--color-sm-green);
      outline-offset: -2px;
    }
    .lb-cell[data-on='0'] {
      background: rgb(0 0 0 / 0.055);
    }
    /* Ghosted rather than hidden: you can see what would land there. */
    .lb-cell[data-on='0'] .lb-inner {
      opacity: 0.13;
    }
    .lb-cell:hover {
      background: rgb(19 114 60 / 0.1);
      outline-color: var(--color-sm-green);
    }
    .lb-cell[data-on='0']:hover .lb-inner {
      opacity: 0.3;
    }

    /* Position number, so the sheet map and the physical sheet can be talked
       about in the same terms. */
    .lb-num {
      position: absolute;
      z-index: 1;
      top: 0;
      left: 0;
      min-width: 1.15rem;
      padding: 0.05rem 0.25rem;
      font-family: var(--font-sans);
      font-size: 0.62rem;
      font-weight: 900;
      line-height: 1.5;
      text-align: center;
      color: #fff;
      background: rgb(0 0 0 / 0.28);
      border-bottom-right-radius: 0.25rem;
    }
    .lb-cell[data-on='1'] .lb-num {
      background: var(--color-sm-green);
    }
    /* The position the editor is showing, in per-label mode. Ink rather than a
       heavier green, because green already means "printing" here and this is
       a different fact - a printing label and the one being edited are often
       the same cell, and have to read as both at once. */
    .lb-cell[data-cur='1'],
    .lb-cell[data-cur='1']:hover {
      outline: 3px solid var(--color-sm-ink);
      outline-offset: -3px;
    }
    .lb-cell[data-cur='1'] .lb-num {
      background: var(--color-sm-ink);
    }

    .lb-bar {
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
      margin-bottom: 0.7rem;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      color: var(--color-sm-slate);
    }
    .pv-label {
      color: var(--color-sm-green);
    }
  }

  /* ============================================================== editor === */

  /* The editor is a white plate on the mist, the same relationship the sheet
     has to the ground on every other page. */
  /* .lb-col supplies the gap between the crumb and the plate. */
  .lb-crumb {
    margin-bottom: 0;
  }
  .lb-editor {
    --pad-x: 1.6rem;
    --pad-y: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: var(--pad-y) var(--pad-x);
    background: var(--color-sm-paper);
    border-radius: 14px;
    box-shadow:
      0 1px 2px rgb(20 25 22 / 0.04),
      0 10px 30px rgb(20 25 22 / 0.06);
  }
  .lb-actions {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  /* .lb-editor is a flex column with its own 1rem gap, so the hero's default
     bottom margin stacked on top of it and left a hole under the panel. */
  .lb-head.sm-hero {
    margin-bottom: 0;
  }
  .lb-editor h1 {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.028em;
    color: var(--color-sm-paper);
  }
  .lb-sub {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-sm-on-green);
  }

  .lb-group {
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-sm-green);
  }
  .lb-group + .lb-field,
  .lb-group + .lb-note {
    margin-top: -0.4rem;
  }

  .lb-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .lb-field > span,
  .lb-field > legend {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-sm-ink);
  }
  .lb-field > span i,
  .lb-field > legend i {
    font-style: normal;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: var(--color-sm-slate);
  }
  .lb-field input[type='text'],
  .lb-editor-shell {
    width: 100%;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--color-sm-line);
    border-radius: 6px;
    background: #fff;
    font: inherit;
    font-size: 0.95rem;
  }
  .lb-field input[type='text']:focus {
    outline: 2px solid var(--color-sm-green);
    outline-offset: -1px;
    border-color: transparent;
  }

  /* ---------------------------------------------------- the subtitle editor */

  /* Quill's own chrome, restyled to sit inside the tool rather than next to it.
     The shell carries the border so the toolbar and the writing area read as
     one field. */
  .lb-editor-shell {
    padding: 0;
    overflow: hidden;
  }
  .lb-editor-shell:focus-within {
    outline: 2px solid var(--color-sm-green);
    outline-offset: -1px;
    border-color: transparent;
  }
  #f-sub-toolbar.ql-toolbar.ql-snow {
    border: 0;
    border-bottom: 1px solid var(--color-sm-line);
    padding: 0.3rem 0.35rem;
    background: #fafafa;
    font-family: inherit;
  }
  .ql-snow.ql-toolbar button {
    width: 1.75rem;
    height: 1.65rem;
    border-radius: 0.25rem;
  }
  .ql-snow.ql-toolbar button:hover {
    background: rgb(19 114 60 / 0.09);
  }
  .ql-snow.ql-toolbar button:hover .ql-stroke,
  .ql-snow.ql-toolbar button.ql-active .ql-stroke {
    stroke: var(--color-sm-green);
  }
  .ql-snow.ql-toolbar button:hover .ql-fill,
  .ql-snow.ql-toolbar button.ql-active .ql-fill {
    fill: var(--color-sm-green);
  }
  .ql-snow.ql-toolbar button.ql-active {
    background: rgb(19 114 60 / 0.13);
  }
  #f-sub.ql-container.ql-snow {
    border: 0;
    font-family: inherit;
    font-size: 0.95rem;
  }
  #f-sub .ql-editor {
    min-height: 4.2rem;
    padding: 0.55rem 0.7rem;
    line-height: 1.4;
  }
  #f-sub .ql-editor.ql-blank::before {
    left: 0.7rem;
    right: 0.7rem;
    font-style: normal;
    color: #a3a3a3;
  }
  #f-sub .ql-editor ol,
  #f-sub .ql-editor ul {
    padding-left: 0.4rem;
  }
  #f-sub .ql-editor code {
    padding: 0 0.15em;
    background: #f1f1f1;
    border-radius: 0.15rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }

  .lb-seg {
    display: flex;
    gap: 0.35rem;
  }
  .lb-seg-wrap {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }
  .lb-seg button {
    flex: 1 1 0;
    /* Not a min-width. The sidebar's content box is 18.8rem (22rem less the
       plate's 1.6rem padding), so three buttons with a 6.5rem floor and two
       0.35rem gaps wanted 20.2rem and the third one hung over the panel's
       right edge - the Align row was the only three-button row on the page,
       which is why the two-button rows never showed it. `flex: 1 1 0` already
       shares the row out evenly; the floor only ever forced the overflow. */
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.5rem 0.4rem;
    border: 1px solid var(--color-sm-line);
    border-radius: 6px;
    background: #fff;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.15;
    cursor: pointer;
    transition:
      border-color 140ms ease,
      background-color 140ms ease,
      color 140ms ease,
      transform 140ms ease;
  }
  .lb-seg button i {
    font-style: normal;
    font-weight: 400;
    font-size: 0.68rem;
