---
import Base from '../layouts/Base.astro';
import BrandSlide from '../components/BrandSlide.astro';
import PhotoSlide from '../components/PhotoSlide.astro';
import EventSlide from '../components/EventSlide.astro';
import { buildReel } from '../lib/reel';

const slides = buildReel();
---

<Base title="Slideshow — Seattle Makers" bare description="Looping reel of studios and upcoming classes at Seattle Makers.">
  <div id="stage-wrap" class="fixed inset-0 overflow-hidden bg-black">
    <div id="stage">
      {
        slides.map((slide, i) => {
          if (slide.type === 'brand') return <BrandSlide />;
          if (slide.type === 'photo')
            return <PhotoSlide studio={slide.studio} src={slide.src} eager={i < 2} />;
          return <EventSlide studio={slide.studio} events={slide.events} />;
        })
      }
    </div>
    {/* Held up to a passer-by who wants to sign up there and then. Sits outside
        #stage so it fills the display rather than the 16:9 artwork. */}
    <div id="qr-overlay" hidden>
      <div class="qr-card">
        <p class="qr-kicker">interested?</p>
        <img src="/brand/qr-interest.svg" alt="QR code linking to seattlemakers.org/interest" />
        <p class="qr-title">scan to get in touch</p>
        <p class="qr-url">seattlemakers.org/interest</p>
      </div>
    </div>

    <p
      id="status"
      hidden
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 rounded bg-black/80 px-6 py-4 text-xl text-white"
    >
    </p>

    {/* Sits outside #stage so it stays a constant physical size whatever the
        display, and never scales up with the 1920x1080 artwork. */}
    <div id="controls" role="group" aria-label="Slideshow controls">
      <button type="button" data-act="prev" title="Previous (←)" aria-label="Previous slide">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15.4 4.6 8 12l7.4 7.4" /></svg>
      </button>

      <button type="button" data-act="play" title="Pause (space)" aria-label="Pause">
        <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 5v14M15 5v14" />
        </svg>
        <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true" hidden>
          <path d="M7 4.8v14.4L19 12z" fill="currentColor" stroke="none" />
        </svg>
      </button>

      <button type="button" data-act="next" title="Next (→)" aria-label="Next slide">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.6 4.6 16 12l-7.4 7.4" /></svg>
      </button>

      <div class="ctl-progress" aria-hidden="true"><i id="progress"></i></div>
      <span id="counter" class="ctl-readout" aria-live="off">1 / 1</span>

      <div class="ctl-sep"></div>

      <button type="button" data-act="slower" title="Slower" aria-label="Slower">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /></svg>
      </button>
      <span id="speed" class="ctl-readout">9s</span>
      <button type="button" data-act="faster" title="Faster" aria-label="Faster">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
      </button>

      <div class="ctl-sep"></div>

      <button type="button" data-act="qr" title="Show interest-form QR (q)" aria-label="Show interest-form QR code">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3.5" y="3.5" width="7" height="7" rx="1" />
          <rect x="13.5" y="3.5" width="7" height="7" rx="1" />
          <rect x="3.5" y="13.5" width="7" height="7" rx="1" />
          <path d="M13.5 13.5h3m4 0h0m-7 4v3m4-3h3m0 4h0" />
        </svg>
      </button>

      <button type="button" data-act="full" title="Full screen (f)" aria-label="Toggle full screen">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
        </svg>
      </button>
    </div>

  </div>
</Base>

<style is:global>
  /* The canvas, including what you overscroll into, so the full-bleed reel
     never flashes the tool pages' mist behind itself. This lives here rather
     than in global.css because it is true of this page alone - there, it was
     painting a black band onto every other page's overscroll. */
  html {
    background: var(--color-sm-ink);
  }

  #stage {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1920px;
    height: 1080px;
    transform-origin: center center;
    background: #000;
  }

  .slide {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0;
    transition: opacity var(--fade-ms, 900ms) ease-in-out;
  }
  .slide.is-active {
    opacity: 1;
    z-index: 1;
  }
  /* Dropped from the loop (past event, or filtered out by ?studios=). */
  .slide.is-out {
    display: none;
  }

  /* Slow push on photo slides. Runs only while the slide is on screen. */
  .ken {
    transform: scale(1.06);
  }
  .is-active .ken {
    animation: ken var(--dwell-ms, 9900ms) linear forwards;
  }
  /* 2D on purpose: a translate3d here promotes the image to its own compositor
     layer, which some capture and remote-display paths render as black. */
  @keyframes ken {
    from {
      transform: scale(1.02) translate(0, 0);
    }
    to {
      transform: scale(1.1) translate(-1.1%, -0.9%);
    }
  }

  body.cursor-hidden {
    cursor: none;
  }

  /* -------------------------------------------------------- qr overlay --- */

  #qr-overlay {
    position: absolute;
    inset: 0;
    z-index: 20;
    display: grid;
    place-items: center;
    background: rgba(17, 17, 17, 0.88);
    backdrop-filter: blur(6px);
  }
  .qr-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(20px, 3.4vmin, 46px) clamp(28px, 4.4vmin, 62px);
    border-radius: clamp(12px, 1.6vmin, 22px);
    background: #fff;
    text-align: center;
  }
  .qr-card img {
    display: block;
    width: clamp(200px, 52vmin, 620px);
    height: auto;
  }
  .qr-kicker {
    margin-bottom: clamp(8px, 1.4vmin, 20px);
    font-size: clamp(15px, 2.6vmin, 40px);
    font-weight: 700;
    color: #111;
  }
  .qr-title {
    margin-top: clamp(10px, 1.8vmin, 26px);
    font-size: clamp(19px, 3.6vmin, 56px);
    font-weight: 900;
    line-height: 1;
    color: var(--color-sm-green, #10733c);
  }
  .qr-url {
    margin-top: clamp(5px, 0.9vmin, 13px);
    font-size: clamp(12px, 1.9vmin, 30px);
    font-weight: 700;
    color: #555;
  }

  /* ---------------------------------------------------------- controls --- */

  /* Bottom-right, not bottom-center: the studio chip owns the bottom-left and
     the wordmark the bottom-center, so this is the one free corner. */
  #controls {
    position: absolute;
    right: 24px;
    bottom: 24px;
    transform: translateY(6px);
    z-index: 10;

    display: flex;
    align-items: center;
    gap: 4px;
    padding: 7px 12px;

    border-radius: 999px;
    background: rgba(17, 17, 17, 0.82);
    backdrop-filter: blur(14px);
    box-shadow: 0 6px 28px rgba(0, 0, 0, 0.45);
    color: #fff;
    font-size: 13px;

    opacity: 0;
    visibility: hidden;
    transition:
      opacity 220ms ease,
      transform 220ms ease,
      visibility 0s linear 220ms;
  }
  /* Revealed by pointer movement, and pinned open while pointer or keyboard
     focus is inside it so a control can never slide away mid-click. */
  #controls.is-shown,
  #controls:hover,
  #controls:focus-within {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition-delay: 0s;
  }

  #controls button {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  #controls button:hover {
    background: rgba(255, 255, 255, 0.16);
  }
  #controls button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 1px;
  }
  #controls svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ctl-readout {
    padding: 0 4px;
    font-variant-numeric: tabular-nums;
    color: rgba(255, 255, 255, 0.85);
    white-space: nowrap;
    user-select: none;
  }
  .ctl-sep {
    width: 1px;
    height: 20px;
    margin: 0 5px;
    background: rgba(255, 255, 255, 0.22);
  }

  .ctl-progress {
    width: 74px;
    height: 3px;
    margin: 0 8px 0 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.25);
    overflow: hidden;
  }
  .ctl-progress > i {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: #fff;
  }
  .ctl-progress > i.run {
    animation: fill var(--dwell-ms, 9900ms) linear forwards;
  }
  @keyframes fill {
    to {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .is-active .ken {
      animation: none;
    }
    .slide {
      transition-duration: 1ms;
    }
  }
</style>

<script>
  import '../scripts/slideshow';
</script>
