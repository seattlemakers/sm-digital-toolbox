---
/**
 * Where everything is: the building, one floor at a time.
 *
 * The plan is drawn from data/floorplan.ts rather than being an image with
 * hotspots over it. That costs an exporter and buys three things an image
 * cannot: the walls are geometry (so they stay sharp at any size and the plan
 * can be measured), the floorplate is derived from the drawing's own outline,
 * and anything placed on top - zones, studios, a route - sits in the same
 * coordinate system as the building rather than being pinned to pixels.
 *
 * The page is two of those plans, each beside a list of everything it is drawn
 * from, for checking rather than for finding your way - a zone with the wrong
 * name still looks like a zone. Hovering either half lights the other.
 *
 * THREE FILES, and the split is deliberate. data/floorplan.ts draws and names
 * the building; data/space/ says which studios work in which of its spaces and
 * who may use them; lib/map-plan.ts says how this page sets the names.
 *
 * EVERYTHING NAMED IS A ZONE, as of 2026-10-11. A room is an unnamed container
 * and carries the access fill; the zones inside it carry the names, the
 * outlines, the hover and the studios. Rooms never light and have no tooltip.
 */
import Base from '../layouts/Base.astro';
import { toolById, pageTitle } from '../data/tools';
import {
  SPACES,
  SPACE_BY_ID,
  STUDIO_BY_SLUG,
  FLOOR_NAME,
  byCode,
  studiosWithoutSpace,
  type Space,
} from '../data/space';
import { FLOORPLAN, FLOORS, STROKE, type Floor, type Layer } from '../data/floorplan';
import { labelStyle, LABEL } from '../lib/map-plan';

const TOOL = toolById('map');

/**
 * The drawing's three layers, in the order they are painted.
 *
 * Stairs first, so the walls land on top of them. A staircase runs right up to
 * the wall it is enclosed by, and drawn over the top its treads cross the wall
 * and poke out the other side - which reads as the stair being in front of the
 * building rather than inside it.
 */
const LAYERS: Layer[] = ['stairs', 'exterior', 'interior'];

const spot = (id: string) => SPACE_BY_ID.get(id)!;
const path = (points: readonly (readonly number[])[]) =>
  `M${points.map((p) => p.join(' ')).join(' L')} Z`;
const r2 = (n: number) => Math.round(n * 100) / 100;
const ORPHANS = studiosWithoutSpace();

const ROOMS = SPACES.filter((s) => s.shape === 'room');
const ZONES = SPACES.filter((s) => s.shape === 'zone');
const zonesOn = (floor: Floor) => ZONES.filter((z) => z.floor === floor);

/**
 * The list, in reading order: every room is a BAR across the list, and its
 * zones sit indented under it - whether it holds five of them or one.
 *
 * The handoff drew a bar only for rooms holding several zones and let a
 * single-zone room collapse into its zone's row; that was reversed on
 * 2026-10-11 so that the list reads as the building does, room by room, and
 * so that every room is one object in it - the same object it is in the data
 * and in /data/space.json - rather than some rooms being rows and others
 * being implied. A bar carries the room's code and nothing else, since a
 * room has nothing else; it is not hoverable, because there is nothing on
 * the plan for it to light. The zones under it are not indented: with a bar
 * over every group, the indent was saying the same thing a second time.
 *
 * THE TEN UNNAMED ZONES ARE NOT LISTED, AND NOR ARE THEIR ROOMS. The list is
 * for checking names and studios, and a hallway has neither - a row reading
 * "U20.1 · not labelled" was a row with nothing on it to check, and the bar
 * left over it was a bar with nothing under it. Nine rooms hold only a
 * hallway or a stair and so do not appear. They stay in the data and in
 * /data/space.json; the lede's count is the data's, the header's is the
 * list's.
 */
type Row = { space: Space; bar: boolean };
function rowsOn(floor: Floor): Row[] {
  return ROOMS.filter((r) => r.floor === floor)
    .sort(byCode)
    .flatMap((room) => {
      const zones = zonesOn(floor).filter((z) => z.room === room.id && z.name !== null).sort(byCode);
      return zones.length ? [{ space: room, bar: true }, ...zones.map((z) => ({ space: z, bar: false }))] : [];
    });
}

/** What the list counts: the zones it shows, not the zones the data holds. */
const listedOn = (floor: Floor) => zonesOn(floor).filter((z) => z.name !== null).length;

/**
 * An entrance arrow, as two paths: a shaft and a solid head.
 *
 * The head is drawn rather than hung on a `marker-end`, which is the usual way
 * and is wrong here for two reasons. A marker needs an id, and this page draws
 * two plans, so the id would have to be made unique per floor or one marker
 * would quietly serve both. And `marker-end` inherits the path's stroke width
 * by default, so the head's size would be tied to the shaft's weight rather
 * than chosen - on a plan this small that is the difference between an arrow
 * and a blob. Three points and a `Z` have neither problem.
 *
 * The shaft stops short of the point by most of the head's length, so the two
 * meet without the stroke's own cap poking out of the tip. 4.6 / 2.8 are the
 * handoff's; they were 3.4 / 1.9 and the arrow read as a hair.
 */
const HEAD = 4.6;
const HALF = 2.8;
function arrow([tail, head]: readonly [readonly [number, number], readonly [number, number]]) {
  const [dx, dy] = [head[0] - tail[0], head[1] - tail[1]];
  const len = Math.hypot(dx, dy);
  const [ux, uy] = [dx / len, dy / len];
  const base = [head[0] - ux * HEAD, head[1] - uy * HEAD];
  return {
    shaft: `M${r2(tail[0])} ${r2(tail[1])} L${r2(base[0] + ux * 0.6)} ${r2(base[1] + uy * 0.6)}`,
    head: `M${r2(head[0])} ${r2(head[1])} L${r2(base[0] - uy * HALF)} ${r2(base[1] + ux * HALF)} L${r2(base[0] + uy * HALF)} ${r2(base[1] - ux * HALF)} Z`,
  };
}

/**
 * A zone's label as the plan sets it: the name on the author's own lines, then
 * the tagline wrapped under it, the whole block CENTRED on the zone's anchor.
 *
 * The NAME's lines come from the data and are not recomputed - see `Zone` in
 * floorplan.ts. The TAGLINE has no layout in the data, so it is wrapped here,
 * greedily, against the zone's own width at the tagline size; it only has to
 * be close, because the cap at load measures the real shaped text.
 *
 * Centring is arithmetic on the line advances: the block is as tall as the sum
 * of its `dy`s, and the first baseline sits half of that above the anchor plus
 * 0.36 of the size, which is about where Figtree's cap height puts the visual
 * middle of a line. `data-cy` and `data-block` carry the inputs so the cap at
 * load can shrink a label and keep it centred.
 */
type Line = { text: string; dy: number; tag: boolean };
function label(sp: Space) {
  const style = labelStyle(sp);
  if (style === 'none') return null;
  const size = sp.size!;
  const { weight, lh } = LABEL[style];
  const T = LABEL.tag;

  const lines: Line[] = sp.lines.map((text, i) => ({ text, dy: i ? size * lh : 0, tag: false }));
  if (sp.tagline) {
    const xs = sp.points.map((pt) => pt[0]);
    const per = Math.max(6, Math.floor((Math.max(...xs) - Math.min(...xs) - 8) / (T.size * T.adv)));
    const out: string[] = [];
    let line = '';
    for (const word of sp.tagline.split(' ')) {
      const next = line ? `${line} ${word}` : word;
      if (next.length > per && line) {
        out.push(line);
        line = word;
      } else line = next;
    }
    if (line) out.push(line);
    lines.push(...out.map((text, i) => ({ text, dy: i ? T.size * T.lh : size * (lh - 1) + T.size * T.gap, tag: true })));
  }

  const blockH = lines.reduce((a, l) => a + l.dy, 0);
  const [cx, cy] = sp.at!;
  return {
    style,
    size,
    weight,
    cx,
    cy,
    blockH: r2(blockH),
    y: r2(cy - blockH / 2 + size * 0.36),
    lines: lines.map((l) => ({ ...l, dy: r2(l.dy) })),
    transform: sp.rotate ? `rotate(${sp.rotate} ${cx} ${cy})` : undefined,
  };
}

/**
 * A zone lights in its STUDIO's colour, and a resource has no colour here.
 *
 * Colour on this plan at rest means who may use a space; on hover it means
 * which studio works there. A resource deliberately is not one, so it falls
 * through to the `var(--studio, slate)` default like the kitchen: grey means
 * only "this is what you are pointing at".
 */
const litStyle = (sp: Space) => {
  const studio = sp.studios.length > 0 ? STUDIO_BY_SLUG.get(sp.studios[0])! : null;
  return studio ? `--studio: ${studio.colour}` : undefined;
};

/** The zone's name and who works in it, in its hover title. */
function tooltip(sp: Space): string {
  const studios = sp.studios.map((slug) => STUDIO_BY_SLUG.get(slug)!.name);
  const name = sp.tagline ? `${sp.name}: ${sp.tagline}` : sp.name!;
  // "(resource)" rather than a studio name, because there is no studio here.
  const tail = studios.length ? studios.join(', ') : sp.resource ? 'resource' : '';
  return tail ? `${name} — ${tail}` : name;
}
---

<Base title={pageTitle(TOOL)} description={TOOL.blurb} shellWidth="72rem">
  <div class="sm-crumb-row">
    <a class="sm-back" href="/">← All tools</a>
  </div>

  <main class="sm-sheet">
    <header class="sm-hero">
      <h1 class="sm-h1">{TOOL.name}</h1>
      <p class="sm-lead">{TOOL.blurb}</p>
    </header>

    {/* WHAT TO CHECK, said once at the top rather than over each floor.

        The plan cannot be reviewed by looking at it: a zone with the wrong name
        still looks like a zone, a zone parented to the wrong room still draws
        in the right place, and a studio pinned to the wrong space is invisible
        to anyone who does not already know where it belongs. All three are
        findable by reading the list beside it. */}
    <p class="mp-lede">
      Each floor's plan sits beside everything it is drawn from. Worth checking
      three things: the <b>name</b> of each space, which <b>room</b> it is in
      - each room is a bar in the list, with its zones under it - and the{' '}
      <b>studio</b> against each one. The fill says who may use a space.{' '}
      <b>{ROOMS.length} rooms and {ZONES.length} zones</b> in all. Hovering
      either side lights the other.
    </p>

    {/* The one pattern on the page, defined once for every svg that follows.
        A fill of url(#id) resolves document-wide, so the two plans and the
        key's swatch all paint from this tile - which is what keeps them the
        same tile. Zero-sized rather than display:none, because a hidden svg's
        defs are not reliably available to other elements. */}
    <svg class="mp-defs" width="0" height="0" aria-hidden="true">
      <defs>
        {/* 45° hatch, 7 units on repeat: white ground, one 0.8 line. In
            drawing units, so the pitch holds however the plan is scaled. */}
        <pattern id="mp-hatch" patternUnits="userSpaceOnUse" width="7" height="7" patternTransform="rotate(45)">
          <rect width="7" height="7" fill="#ffffff" />
          <line x1="0" y1="0" x2="0" y2="7" class="mp-hatch-line" />
        </pattern>
      </defs>
    </svg>

    {/* The key. Three fills and three words; the plan carries no other colour
        at rest, so this is the whole legend. The staff swatch is an svg so
        it can paint from the same pattern the plan does. */}
    <ul class="mp-key" aria-label="Fill key">
      <li><span class="mp-swatch is-public"></span>Public</li>
      <li><span class="mp-swatch"></span>Members</li>
      <li><svg class="mp-swatch is-staff" viewBox="0 0 16 16"><rect width="16" height="16" fill="url(#mp-hatch)" /></svg>Staff only</li>
    </ul>

    {
      FLOORS.map((floor) => (
        <section class="mp-floor" data-floor={floor}>
          <h2 class="mp-floor-h">
            {FLOOR_NAME[floor].name}
            <span>{FLOOR_NAME[floor].sub}</span>
          </h2>

          <div class="mp-pair">
            <div class="mp-plan-wrap">
              <svg
                class="mp-plan"
                viewBox={FLOORPLAN[floor].viewBox}
                role="img"
                aria-label={`Floorplan of the ${FLOOR_NAME[floor].name.toLowerCase()} floor`}
              >
                {/* North is up on the drawing, so it is up here. The one thing on
                    the plan that is not the building, and it earns the space:
                    every instruction anyone gives in here is "past the woodshop",
                    not "north", so the arrow is what ties the two together. */}
                <g
                  class="mp-north"
                  transform={`translate(${+FLOORPLAN[floor].viewBox.split(' ')[0] + 10} ${+FLOORPLAN[floor].viewBox.split(' ')[1] + 14}) scale(0.34)`}
                >
                  <path d="M 18 58 L 30 18 L 42 58 L 30 48 Z" />
                  <text x="30" y="80">N</text>
                </g>

                <g transform={`translate(0 ${FLOORPLAN[floor].offsetY})`}>
                  {/* The floorplate, under everything. */}
                  <polygon
                    class="mp-shell"
                    points={FLOORPLAN[floor].outline.map((q) => q.join(',')).join(' ')}
                  />

                  {/* ROOMS: a fill and nothing else. No name, no hover, no
                      title - a room is the container, and the fill it carries
                      says who may use what is inside it. */}
                  {FLOORPLAN[floor].rooms.map((r) => (
                    <path
                      class="mp-room"
                      d={path(r.points)}
                      data-access={spot(r.id).access}
                    />
                  ))}

                  {/* ZONES, dashed. A zone has no wall between it and its room -
                      that is what makes it a zone - so it cannot be drawn as one.
                      A dashed line is the convention for a boundary you can walk
                      straight through, which is exactly what this is. An unnamed
                      zone draws nothing and answers to nothing; a zone that
                      states its own access paints it over the room's. */}
                  {FLOORPLAN[floor].zones.map((z) =>
                    spot(z.id).name === null ? (
                      <path class="mp-zone is-unnamed" d={path(z.points)} />
                    ) : (
                      <path
                        class:list={['mp-zone', spot(z.id).ownAccess && 'has-access']}
                        d={path(z.points)}
                        data-spot={z.id}
                        data-access={spot(z.id).ownAccess ? spot(z.id).access : undefined}
                        style={litStyle(spot(z.id))}
                      >
                        <title>{tooltip(spot(z.id))}</title>
                      </path>
                    ),
                  )}

                  {/* The building. Three weights and no others; the gaps are the
                      doorways. */}
                  {LAYERS.map((layer) => (
                    <path
                      class={`mp-wall is-${layer}`}
                      d={FLOORPLAN[floor].d[layer]}
                      stroke-width={STROKE[layer]}
                    />
                  ))}

                  {/* The names, over everything, each centred on the author's
                      own anchor and broken on their own lines - both are fitted
                      to the zone they sit in, and recomputing either would be
                      guessing at a decision somebody made with the plan in front
                      of them. */}
                  {FLOORPLAN[floor].zones.map((z) => {
                    const l = label(spot(z.id));
                    return (
                      l && (
                        <text
                          class={`mp-name is-${l.style}`}
                          data-spot={z.id}
                          data-cy={l.cy}
                          data-block={l.blockH}
                          data-rot={l.transform ? '1' : undefined}
                          x={l.cx}
                          y={l.y}
                          transform={l.transform}
                          style={`font-size: ${l.size}px; font-weight: ${l.weight}`}
                        >
                          {l.lines.map((line) => (
                            <tspan x={l.cx} dy={line.dy} class:list={[line.tag && 'mp-tagline']}>
                              {line.text}
                            </tspan>
                          ))}
                        </text>
                      )
                    );
                  })}

                  {/* The ways in, which name a door from outside rather than
                      naming a space. They carry no id in the review list and
                      nothing hovers them - there is no room to light up. The
                      anchor goes in `style`, not as an attribute: the
                      stylesheet's `text-anchor: middle` outranks a
                      presentation attribute, and a label set `start` in the
                      data was coming out centred. */}
                  {FLOORPLAN[floor].entrances.map((e) => [
                    <path class="mp-arrow-shaft" d={arrow(e.arrow).shaft} />,
                    <path class="mp-arrow-head" d={arrow(e.arrow).head} />,
                    <text
                      class="mp-entrance"
                      x={e.at[0]}
                      y={e.at[1]}
                      style={`font-size: ${e.size}px${e.anchor ? `; text-anchor: ${e.anchor}` : ''}`}
                    >
                      {e.lines.map((line, i) => (
                        <tspan x={e.at[0]} dy={i ? r2(e.size * 1.12) : 0}>{line}</tspan>
                      ))}
                    </text>,
                  ])}
                </g>
              </svg>
            </div>

            {/* The list beside the plan rather than under it, so one can be read
                against the other without either leaving the screen. It scrolls
                inside its own box for the same reason: a floor is 25 to 28 zones
                and the plan would otherwise be a long way up the page. */}
            <div class="mp-list-col">
              <div class="mp-list">
                <div class="mp-list-head">
                  <span>Spaces</span>
                  <span>{listedOn(floor)} zones</span>
                </div>

                <div class="mp-list-scroll">
                  <table class="mp-table">
                    <thead>
                      <tr>
                        <th class="mp-th-code">Code</th>
                        <th>Space</th>
                        <th>Studio</th>
                      </tr>
                    </thead>
                    <tbody>
                      {rowsOn(floor).map(({ space: sp, bar }) =>
                        bar ? (
                          <tr class="is-bar">
                            <td colspan="3">{sp.id}</td>
                          </tr>
                        ) : (
                          <tr
                            data-spot={sp.id}
                            style={litStyle(sp)}
                          >
                            <td class="mp-code">{sp.id}</td>
                            <td class="mp-space">
                              <span class="mp-space-name">{sp.name}</span>
                            </td>
                            <td class="mp-who">
                              {sp.studios.length === 0 ? (
                                <span class="mp-dash">—</span>
                              ) : (
                                sp.studios.map((slug) => {
                                  const st = STUDIO_BY_SLUG.get(slug)!;
                                  return (
                                    <span class="mp-who-one">
                                      <img src={st.badge} alt="" width="22" height="22" />
                                      {st.name}
                                    </span>
                                  );
                                })
                              )}
                            </td>
                          </tr>
                        ),
                      )}
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </section>
      ))
    }

    {
      ORPHANS.length > 0 && (
        <section class="mp-todo">
          <h2>Still to place</h2>
          <ul>
            <li>
              <b>{ORPHANS.map((st) => st.name).join(', ')}</b> — no space on the plan
              claims {ORPHANS.length === 1 ? 'this studio' : 'these studios'} yet.
            </li>
          </ul>
        </section>
      )
    }

    {/* The same names, in a form somebody can diff, paste into a message or
        hand to whoever keeps the building's own list. Linked rather than left
        to be discovered: a reviewer who wants to check fifty-three names
        against something else should not have to be told these exist. */}
    <p class="mp-files">
      <span>Also as data</span>
      <a href="/data/space.json">space.json</a>
    </p>

    <p class="mp-note">
      Every name, shape and label position above comes from{' '}
      <b>data/floorplan.ts</b>, which is authored by hand rather than traced.{' '}
      <b>data/space/</b> adds what the drawing cannot know: which studios work
      where, who may use each space, and the taglines under the names.
    </p>
  </main>
</Base>

<style>
  /* The handoff's tokens that are this page's alone. The site's own tokens
     cover ink, slate, mist and the hairline; these four are the access fills,
     the quiet type and the group row, and nothing else on the site uses them. */
  .sm-sheet {
    --mp-quiet: #7d8480;
    --mp-public: #e2efe5;
    --mp-hatch: #c4cac6;
    --mp-inset: #b7bdb9;
    --mp-group: #f8f9f8;
  }

  .mp-defs {
    position: absolute;
  }

  .mp-hatch-line {
    stroke: var(--mp-hatch);
    stroke-width: 0.8;
  }

  .mp-floor + .mp-floor {
    margin-top: 3.25rem;
  }

  .mp-floor-h {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin-bottom: 1rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--color-sm-ink);
  }

  .mp-floor-h span {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-sm-slate);
  }

  /* ------------------------------------------------------------- the key --- */
  .mp-key {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-sm-ink-2);
  }

  .mp-key li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* The swatches are the fills exactly, with the same 1px inset the plan's
     walls give a room, so the key is a sample of the plan and not a diagram
     of it. */
  .mp-swatch {
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 3px;
    background: var(--color-sm-paper);
    box-shadow: inset 0 0 0 1px var(--mp-inset);
  }

  .mp-swatch.is-public {
    background: var(--mp-public);
  }

  .mp-swatch.is-staff {
    display: block;
    overflow: hidden;
  }

  /* The plan takes the room it needs and the list takes what is left, with a
     floor under the list: below about 18rem the studio column starts wrapping
     its own names, and a wrapped name is the one thing in here that has to be
     read straight.

     The cap is 26rem and was 24, which is a measured pixel rather than a
     preference. The studio column takes max-content - the widest of it is
     "Printmaking" with its badge - on every row, so what is left for a name is
     fixed however wide the window gets. */
  .mp-pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 26rem);
    gap: 1.25rem;
    /* stretch, not start: the list is told to be exactly as tall as the plan,
       and the way it is told is by filling a column that the plan's own height
       has already decided. See .mp-list-col. */
    align-items: stretch;
  }

  /* Three tones, darkest outwards: the ground outside the building, the floor
     inside it, then the rooms. */
  .mp-plan-wrap {
    padding: 0.75rem;
    background: #e3e7e4;
    border-radius: 12px;
  }

  /* `overflow: visible` is load-bearing. The Member Entrance label and the
     tail of its arrow sit BELOW the upstairs viewBox - centred in the band
     between the south wall and the plate's edge, which is the padding above -
     and a clipping svg would cut the words in half. */
  .mp-plan {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .mp-north path {
    fill: var(--color-sm-slate);
    opacity: 0.55;
  }

  .mp-north text {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    text-anchor: middle;
    fill: var(--color-sm-slate);
    opacity: 0.55;
  }

  .mp-shell {
    fill: var(--color-sm-mist);
  }

  /* ------------------------------------------------------------ colour ---

     COLOUR AT REST SAYS WHO MAY USE A SPACE, and nothing else. Members is
     white, public is a light green, staff only is a hatch - and the hatch is a
     pattern rather than a grey because a grey room reads as a room that is
     shut, where a hatch reads as a room that is somebody else's. A zigzag for
     public over a flat grey for staff was tried on 2026-10-11 and undone the
     same hour: the grey put the quiet labels at 2.1:1 on their own rooms, and
     the zigzag read as texture rather than as a fill. The plan is otherwise
     the walls and the names.

     Until 2026-10-11 there was no colour at rest at all; before that, the
     studios were a green wash. Both histories are in CLAUDE.md. What stayed
     true through all three: a hover is the only time a studio's colour appears.

     Rooms do not respond to the pointer. The fill is theirs, the name and the
     hover belong to the zones inside them, and a room with no named zone under
     the cursor lights nothing - which is right, because there is nothing in
     the list to light. */
  .mp-room {
    fill: var(--color-sm-paper);
    pointer-events: none;
  }

  .mp-room[data-access='public'] {
    fill: var(--mp-public);
  }

  .mp-room[data-access='staff'] {
    fill: url(#mp-hatch);
  }

  /* A zone has no wall between it and its room - that is what makes it a zone -
     so it cannot be drawn as one. Dashes are the convention for a boundary you
     walk straight through. In drawing units, so the dash keeps its size on the
     plan however the page is scaled.

     `pointer-events: all` rather than the default, which only hits painted
     pixels: a zone with no fill would otherwise be hoverable along its dashes
     and nowhere else. */
  .mp-zone {
    fill: none;
    stroke: var(--color-sm-slate);
    stroke-width: 1.1;
    stroke-dasharray: 4 3;
    opacity: 0.55;
    pointer-events: all;
    transition: fill 140ms ease;
  }

  /* A hallway, a stair, the landing: drawn so the data is complete and
     invisible so the plan is not. No outline, no hit target. */
  .mp-zone.is-unnamed {
    stroke: none;
    pointer-events: none;
  }

  /* A zone stating its own access paints it over the room's, at full strength:
     the Staff Desk is a hatched corner of a white room. */
  .mp-zone.has-access {
    fill: var(--color-sm-paper);
    opacity: 1;
  }

  .mp-zone.has-access[data-access='public'] {
    fill: var(--mp-public);
  }

  .mp-zone.has-access[data-access='staff'] {
    fill: url(#mp-hatch);
  }

  /* ------------------------------------------------------------ labels ---

     TWO STYLES, as lib/map-plan.ts decides them. Bold is ink at 650; quiet is
     grey at 450 and smaller. Both are Figtree, mixed case, untracked, and
     neither carries an outline. Everything that used to tell a room from a
     zone - caps against lower, roman against italic, three weights - went
     with the room labels: there is one kind of named thing on this plan now.

     The weight is set inline from the data beside the size, so the two rules
     here carry only the colour. */
  .mp-name {
    font-family: var(--font-display);
    text-anchor: middle;
    fill: var(--color-sm-ink);
    pointer-events: none;
    transition: fill 140ms ease;
  }

  .mp-name.is-quiet {
    fill: var(--mp-quiet);
  }

  /* A tagline is the second thing on a label, so it is set as the second
     thing: the quiet size and weight, in the quiet grey, whatever the name
     above it is doing. */
  .mp-tagline {
    font-size: 7px;
    font-weight: 450;
    fill: var(--mp-quiet);
    transition: fill 140ms ease;
  }

  /* A way in, and the only type on this plan that is not naming a space.

     Uppercase and tracked, because it is read once to get your bearings rather
     than looked up, and set in slate so that out on the grey it does not pull
     the eye off the building. */
  .mp-arrow-shaft {
    fill: none;
    stroke: var(--color-sm-slate);
    stroke-width: 1.8;
    stroke-linecap: butt;
    opacity: 0.9;
    pointer-events: none;
  }

  .mp-arrow-head {
    fill: var(--color-sm-slate);
    stroke: none;
    opacity: 0.9;
    pointer-events: none;
  }

  .mp-entrance {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-anchor: middle;
    text-transform: uppercase;
    fill: var(--color-sm-slate);
    pointer-events: none;
  }

  /* The building, and the only thing on the plan drawn in ink. If it is dark
     you cannot walk through it - except the stairs, which are drawn lightest of
     the three for exactly that reason: a staircase is a thing you walk on.

     The weights are the drawing's own (6 / 3 / 1.5) and are set per path from
     the data, so a redrawn floorplan changes them by being redrawn.

     `square` caps are the drawing's too, and overriding them to `butt` was a
     mistake worth recording. The argument was that a square cap overshoots by
     half a stroke at every subpath end, and every subpath end here is either a
     door jamb or a corner - so butt caps keep the doorways exactly as the path
     data states them. True, and it misses two things.

     Ten corners on this plan are formed by two SEPARATE subpaths meeting at a
     point, including the downstairs building's own top-left. A mitre join only
     closes a corner inside one subpath; between two, butt caps leave a notch of
     half a stroke square, and the plan looks like it was drawn with a shaky
     hand. Square caps fill exactly that notch - that is what the cap is for.

     And the doorways were never narrowed: the author drew the gaps with square
     caps switched on, so the opening they designed is the gap MINUS the caps.
     Butt caps made every interior door 3 units wider than intended, not
     correct. The gap is 18.4, the cap takes 1.5 from each side, the door is
     15.4, and that is the drawing's door. */
  .mp-wall {
    fill: none;
    stroke: var(--color-sm-ink);
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  /* The stairs recede. Same ink family, so they still read as built rather than
     as annotation, but they are never the thing you are trying to find. */
  .mp-wall.is-stairs {
    stroke: var(--color-sm-slate);
    opacity: 0.6;
  }

  /* ------------------------------------------------- one lit at a time ---

     Hovering either half lights the same zone in the other, which is the whole
     reason the list sits beside the plan rather than under it. Every one of
     these rules has to sit BELOW the fills it overrides: .mp-zone.is-lit and
     .mp-zone.has-access both weigh (0,2,0), so source order alone decides
     which fill wins.

     It is a fill and never a stroke. A stroke that thickens moves the wall it
     is drawn on, and the zone appears to twitch under the cursor.

     A zone that IS a studio lights in that studio's own colour, which is what
     makes the badge in the list and the shape on the plan one object. Anything
     else - a kitchen, a resource, the check-in desk - falls back to slate
     through the var()'s own default: grey means only "this is what you are
     pointing at".

     0.5 rather than the 0.2 a resting tint would use, and it has to be: these
     are ten brand colours of wildly different lightness, and woodshop's gold
     at 0.2 is barely a change against white. At 0.5 the palest still registers
     and the darkest - the leather brown - is still something ink reads over. */
  .mp-zone.is-lit {
    fill: var(--studio, var(--color-sm-slate));
    fill-opacity: 0.5;
    opacity: 1;
  }

  /* The name lights with the zone, and takes ink whatever its style was. On a
     small zone the fill alone is easy to miss, and the name is what you are
     looking for anyway. Ink rather than the studio's colour, and that was
     measured rather than chosen: eight of the brand colours fail 4.5:1 as type
     on white, and here they would be type on a wash of themselves. */
  .mp-name.is-lit,
  .mp-name.is-lit .mp-tagline {
    fill: var(--color-sm-ink);
  }

  /* ---------------------------------------------------------- the data --- */

  /* The list is exactly as tall as the plan beside it, and this is the whole
     trick: a grid row is as tall as its tallest item, so the column holding
     the list must contribute NO height of its own. Its only child is taken out
     of flow, so it measures zero, the row is left to the plan, and the card
     then fills that row with inset: 0.

     A max-height cannot do this. The plan's height is its column's width over
     the drawing's aspect, which changes with every window width, so any fixed
     cap is the right number at one size and wrong at all the others.

     It needs no ResizeObserver either, which the rest of this repo would
     otherwise reach for: the plan is sized by the grid and the list follows it
     in the same layout pass. */
  .mp-list-col {
    position: relative;
    min-width: 0;
  }

  /* A card rather than a bare table, because beside a plan on a tinted ground
     a column of hairlines with no edge reads as something that fell off the
     page. The radius clips the scroller, which is why the overflow is here as
     well as on the child. */
  .mp-list {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-sm-line);
    border-radius: 12px;
    background: #fff;
  }

  .mp-list-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    flex: 0 0 auto;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--color-sm-line);
    background: var(--color-sm-mist);
    font-family: var(--font-display);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-sm-slate);
  }

  .mp-list-scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    /* A list that scrolls inside a page that also scrolls hands the page its
       overscroll at either end, so reaching the bottom of a floor's list jumps
       the whole page away from the plan it is being read against. */
    overscroll-behavior: contain;
  }

  .mp-lede {
    margin: 0 0 1.5rem;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-sm-slate);
  }

  .mp-lede b {
    font-weight: 600;
    color: var(--color-sm-ink-2);
  }

  .mp-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
  }

  /* Hairline rows rather than a bordered grid: this is a list to read down,
     and the one vertical relationship that matters - a zone under its room -
     is said by the indent instead. */
  /* The header has to survive the scroll, and a sticky cell cannot hold a
     border - the row it is pinned over slides under it and the border goes
     with the paint. An inset shadow draws inside the cell instead. */
  .mp-table th {
    position: sticky;
    top: 0;
    z-index: 1;
    padding: 0.45rem 0.6rem;
    background: #fff;
    box-shadow: inset 0 -1px 0 var(--color-sm-line);
    font-family: var(--font-display);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-align: left;
    color: var(--color-sm-slate);
  }

  .mp-table td {
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--color-sm-line);
    vertical-align: middle;
  }

  .mp-table tr:last-child td {
    border-bottom: 0;
  }

  .mp-th-code,
  .mp-code {
    width: 1%;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    font-size: 0.8125rem;
    color: var(--color-sm-slate);
  }

  /* A room is a bar across the list: its code on a tinted band spanning every
     column, with the zones it holds under it. The band is what separates one
     room from the next, so the list reads room by room rather than as
     fifty-three rows of equal weight. The zones under a bar carry no indent
     and no `└` - the bar already says what they belong to, and a marker on
     every row of the list is a marker on none.

     Every name is set the same here, whatever the plan does with it. The plan
     has two label styles because it is a drawing with room for a hierarchy;
     the list is a list, and a quiet row in it read as a row that mattered
     less to check, which is the opposite of what the list is for. */
  .mp-table tr.is-bar td {
    padding: 0.3rem 0.6rem;
    background: var(--mp-group);
    border-top: 1px solid var(--color-sm-line);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-label);
    color: var(--color-sm-slate);
  }

  .mp-table tr.is-bar:first-child td {
    border-top: 0;
  }

  .mp-space-name {
    font-family: var(--font-display);
    /* `pretty` rather than `balance`: balance evens the line lengths, which
       reads as ragged against the hard left edge these sit on. */
    text-wrap: pretty;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-sm-ink);
  }

  /* A little more room on the right than the other cells, because an overlay
     scrollbar appears over the content rather than beside it and this is the
     column it would land on. */
  .mp-who {
    width: 1%;
    padding-right: 0.95rem;
    white-space: nowrap;
  }

  /* Ink rather than the brand green. Green on this page means one thing - the
     thing you are pointing at - and a studio name is not that. The badge beside
     it already says "studio", and says it in that studio's own colour. */
  .mp-who-one {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    /* An inline-flex takes its baseline from its FIRST flex item, and the first
       one here is an image, whose baseline is its bottom edge. Aligning the box
       itself rather than its invented baseline puts it within half a pixel. */
    vertical-align: middle;
    font-size: 0.875rem;
    color: var(--color-sm-ink-2);
  }

  .mp-who-one + .mp-who-one {
    margin-left: 0.7rem;
  }

  .mp-who-one img {
    flex: 0 0 auto;
  }

  .mp-dash {
    color: var(--color-sm-line);
  }

  /* Same rule as the plan: the studio's own colour, grey for everything else.
     Lighter than the plan's wash, because a table row is a long thin band of
     it next to type rather than a shape on a drawing. */
  .mp-table tr.is-lit td {
    background: color-mix(in srgb, var(--studio, var(--color-sm-slate)) 26%, transparent);
  }

  .mp-todo {
    margin-top: 3rem;
    padding: 1.1rem 1.25rem;
    background: var(--color-sm-mist);
    border-left: 4px solid var(--color-sm-green-mid);
    border-radius: 0 10px 10px 0;
  }

  .mp-todo h2 {
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-sm-slate);
  }

  .mp-todo ul {
    display: grid;
    gap: 0.45rem;
  }

  .mp-todo li {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-sm-ink-2);
  }

  .mp-files {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    margin-top: 2.5rem;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .mp-files span {
    color: var(--color-sm-slate);
  }

  .mp-files a {
    color: var(--color-sm-green);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-sm-green) 35%, transparent);
  }

  .mp-files a:hover,
  .mp-files a:focus-visible {
    color: var(--color-sm-green-dark);
    border-bottom-color: currentColor;
  }

  .mp-note {
    max-width: 62ch;
    margin-top: 1.1rem;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-sm-slate);
  }

  /* Side by side needs about 44rem for the plan and 18 for the list. Under
     that they stack, and the list comes down off the plan's height to
     something that still leaves the plan on screen above it. */
  @media (max-width: 62rem) {
    .mp-pair {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Stacked there is no plan beside it to match, so the card goes back into
       the flow and takes a height of its own. */
    .mp-list-col {
      position: static;
    }

    .mp-list {
      position: static;
      height: 24rem;
    }
  }

  @media (max-width: 40rem) {
    /* The plan is the one thing here that cannot usefully shrink any further,
       so at phone width it gets the sheet's own gutters back. */
    .mp-plan-wrap {
      margin: 0 calc(var(--pad-x) * -1);
      padding: 0.6rem;
      border-radius: 0;
    }

    /* The badge is the first thing to go: at this width the name is what is
       being checked and the picture is 22px of decoration beside it. */
    .mp-who-one img {
      display: none;
    }

    .mp-table th,
    .mp-table td {
      padding-left: 0.35rem;
      padding-right: 0.35rem;
    }
  }
</style>

<script>
  /* A name may not be wider than the zone it names.

     The sizes and line breaks are the data's own and are left alone - they
     were set with the plan in front of somebody, and in drawing units, so
     they hold at every page size. What the author cannot check is how a name
     sets in the browser's shaping of Figtree, so this only ever SHRINKS, and
     only the labels that need it. It measures rather than estimates - getBBox
     is the real shaped text, in user units, so one pass at load holds at every
     size the plan is drawn at.

     Two things it leaves alone: a ROTATED label, which runs along the zone's
     long axis and would be measured against the wrong side, and the entrance
     labels, which have no zone. And when it does shrink one, it moves the
     baseline too - the block is centred on its anchor by arithmetic on its
     line advances, so a smaller block has to climb back up to stay centred. */
  for (const svg of document.querySelectorAll<SVGSVGElement>('svg.mp-plan')) {
    for (const label of svg.querySelectorAll<SVGTextElement>('text.mp-name[data-spot]')) {
      if (label.dataset.rot) continue;
      const zone = svg.querySelector<SVGGraphicsElement>(`path[data-spot="${label.dataset.spot}"]`);
      if (!zone) continue;
      const ink = label.getBBox();
      const walls = zone.getBBox();

      // The zone's width is not the room the LABEL has. These are centred on
      // their anchor and shrinking the type pulls both ends in towards it, so
      // what a name can use is twice its smaller side - which is the whole
      // width only when the anchor happens to sit in the middle.
      const centre = ink.x + ink.width / 2;
      // Two units of air at each end, so a capped name does not simply touch
      // the wall instead of crossing it.
      const room = 2 * Math.min(centre - walls.x, walls.x + walls.width - centre) - 4;
      if (ink.width > room && room > 0) {
        const size = parseFloat(getComputedStyle(label).fontSize);
        const k = room / ink.width;
        label.style.fontSize = `${size * k}px`;
        // Everything in the block scales with the font, so the block is k as
        // tall and the first baseline climbs to keep its centre where it was.
        const cy = Number(label.dataset.cy);
        const block = Number(label.dataset.block);
        label.setAttribute('y', String(cy - (block * k) / 2 + size * k * 0.36));
        for (const t of label.querySelectorAll('tspan')) {
          t.setAttribute('dy', String(Number(t.getAttribute('dy')) * k));
        }
      }
    }
  }

  /* Hover one, light the other.

     Delegated per floor rather than per element: a pair is one plan and about
     thirty rows, and the plan's own zones come and go with the drawing. Scoped
     to the pair as well, so the upstairs list cannot light a downstairs zone.

     The names on the plan are pointer-events: none, so a label hands the hover
     to the zone underneath it rather than being a dead patch in the middle of
     the space it names. They still carry data-spot, because they light too.
     Rooms and unnamed zones carry none, so pointing at them lights nothing. */
  for (const pair of document.querySelectorAll<HTMLElement>('.mp-pair')) {
    const paint = (id: string | null) => {
      for (const el of pair.querySelectorAll('.is-lit')) el.classList.remove('is-lit');
      if (id) for (const el of pair.querySelectorAll(`[data-spot="${id}"]`)) el.classList.add('is-lit');
    };

    pair.addEventListener('pointerover', (e) => {
      paint((e.target as Element).closest('[data-spot]')?.getAttribute('data-spot') ?? null);
    });
    pair.addEventListener('pointerleave', () => paint(null));
  }
</script>
