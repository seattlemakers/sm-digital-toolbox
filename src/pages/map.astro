---
/**
 * Where everything is: the building, one floor at a time.
 *
 * The plan is drawn from data/floorplan.svg rather than being an image with
 * hotspots over it. That costs an extractor and buys three things an image
 * cannot: the walls are geometry (so they stay sharp at any size and the plan
 * can be measured), the floorplate is derived from the drawing's own outline,
 * and anything placed on top - rooms, studios, a route - sits in the same
 * coordinate system as the building rather than being pinned to pixels.
 *
 * The page is two of those plans, each beside a list of everything it is drawn
 * from, for checking rather than for finding your way - a room with the wrong
 * name still looks like a room. Hovering either half lights the other.
 *
 * THREE FILES, and the split is deliberate. data/floorplan.svg draws and names
 * the building; data/rooms.ts says which studios work in which of its spaces;
 * data/space-studios.ts is the map's own studio list, forked from
 * data/studios.ts on 2026-10-06 because that one is shaped by the calendar it
 * feeds. Nothing on this page reads data/studios.ts any more.
 */
import Base from '../layouts/Base.astro';
import { toolById, pageTitle } from '../data/tools';
import { SPOTS, studiosWithoutSpot, type Spot } from '../data/rooms';
import { FLOORPLAN, FLOORS, STROKE, type Floor, type Layer } from '../data/floorplan';
import { SPACE_STUDIO_BY_SLUG } from '../data/space-studios';

const TOOL = toolById('map');

/**
 * The drawing's three layers, in the order they are painted.
 *
 * Stairs first, so the walls land on top of them. A staircase runs right up to
 * the wall it is enclosed by, and drawn over the top its treads cross the wall
 * and poke out the other side - which reads as the stair being in front of the
 * building rather than inside it.
 */
const LAYERS: Layer[] = ['stairs', 'exterior', 'interior'];

/** What each floor is called on the page. The geometry is the drawing's. */
const FLOOR_NAME: Record<Floor, { title: string; sub: string }> = {
  upstairs: { title: 'Upstairs', sub: '2nd floor' },
  downstairs: { title: 'Downstairs', sub: '1st floor' },
};

const spot = (id: string) => SPOTS.find((s) => s.id === id)!;

/**
 * The drawing's label sizes were set in Archivo Narrow and the site sets
 * Figtree, which is wider - so a name tuned to its room in one face overflows
 * it in the other. Measured rather than guessed: see *Labels* in CLAUDE.md.
 */
const LABEL_SCALE = 0.88;
const path = (points: readonly (readonly number[])[]) =>
  `M${points.map((p) => p.join(' ')).join(' L')} Z`;
const ORPHANS = studiosWithoutSpot();

/**
 * Every space on a floor, in reading order, each room followed by its own
 * zones.
 *
 * The drawing's order is the order the author drew in - U15 sits between U9 and
 * U10, D20 between D7 and D8 - which is nothing to do with how the building
 * reads and makes a list of fifty-seven rows impossible to check against. The
 * codes sort numerically rather than as text, so U10 does not land between U1
 * and U2, and a zone sorts under the room it belongs to rather than into a
 * block of its own at the end: "is the Jewelry Studio inside Metal Studios?" is
 * exactly the question this table is here to have answered, and it can only be
 * answered if the two are next to each other.
 */
const codeAt = (id: string): [number, number] => {
  const [, major, minor = '0'] = id.match(/^[A-Z](\d+)(?:\.(\d+))?$/) ?? [];
  return [Number(major), Number(minor)];
};
const byCode = (a: Spot, b: Spot) =>
  codeAt(a.id)[0] - codeAt(b.id)[0] || codeAt(a.id)[1] - codeAt(b.id)[1];

function rowsOn(floor: Floor): Spot[] {
  const here = SPOTS.filter((s) => s.floor === floor);
  return here
    .filter((s) => s.shape === 'room')
    .sort(byCode)
    .flatMap((room) => [room, ...here.filter((s) => s.room === room.id).sort(byCode)]);
}

/**
 * What colour a space lights up in: its studio's, or nothing.
 *
 * Only a space that IS a studio has one. A room whose studios are all in its
 * zones - the Fab Lab, the Megastudio, the Garage - deliberately has none: it
 * holds two disciplines and is not either of them, so it falls back to the
 * plan's own green. Every space carries at most one studio, so the first is
 * the only.
 *
 * `style` is left off entirely rather than set empty, so the CSS falls through
 * to the default in its own var() rather than to an empty custom property.
 */
const litStyle = (sp: Spot) => {
  const studio = sp.studios.length > 0 ? SPACE_STUDIO_BY_SLUG.get(sp.studios[0])! : null;
  return studio ? `--studio: ${studio.colour}` : undefined;
};

const ROOMS = SPOTS.filter((s) => s.shape === 'room');
const ZONES = SPOTS.filter((s) => s.shape === 'zone');

/**
 * The space's name and who works in it, in its hover title.
 *
 * The room list was cut on 2026-10-05 and this is where the one thing it said
 * that the plan does not went. The names are drawn on the plan already; which
 * studio is in which room is the mapping this page exists for.
 */
function tooltip(id: string): string {
  const sp = SPOTS.find((s) => s.id === id)!;
  const studios = sp.studios.map((slug) => SPACE_STUDIO_BY_SLUG.get(slug)!.name);
  return studios.length ? `${sp.name} — ${studios.join(', ')}` : sp.name;
}
---

<Base title={pageTitle(TOOL)} description={TOOL.blurb} shellWidth="72rem">
  <div class="sm-crumb-row">
    <a class="sm-back" href="/">← All tools</a>
    <span class="sm-stamp">Interbay · 2 floors</span>
  </div>

  <main class="sm-sheet">
    <header class="sm-hero">
      <h1 class="sm-h1">{TOOL.name}</h1>
      <p class="sm-lead">{TOOL.blurb}</p>
    </header>

    {/* WHAT TO CHECK, said once at the top rather than over each floor.

        The plan cannot be reviewed by looking at it: a room with the wrong name
        still looks like a room, a zone parented to the wrong room still draws
        in the right place, and a studio pinned to the wrong space is invisible
        to anyone who does not already know where it belongs. All three are
        findable by reading the list beside it. */}
    <p class="mp-lede">
      Each floor's plan sits beside everything it is drawn from. Worth checking
      three things: the <b>name</b> of each space, which spaces are <b>zones</b>{' '}
      of a larger room, and the <b>studio</b> against each one.{' '}
      <b>{ROOMS.length} rooms and {ZONES.length} zones</b> in all. Hovering
      either side lights the other.
    </p>

    {
      FLOORS.map((floor) => (
        <section class="mp-floor" data-floor={floor}>
          <h2 class="mp-floor-h">
            {FLOOR_NAME[floor].title}
            <span>{FLOOR_NAME[floor].sub}</span>
          </h2>

          <div class="mp-pair">
            <div class="mp-plan-wrap">
              <svg
                class="mp-plan"
                viewBox={FLOORPLAN[floor].viewBox}
                role="img"
                aria-label={`Floorplan of the ${FLOOR_NAME[floor].title.toLowerCase()} floor`}
              >
                {/* North is up on the drawing, so it is up here. The one thing on
                    the plan that is not the building, and it earns the space:
                    every instruction anyone gives in here is "past the woodshop",
                    not "north", so the arrow is what ties the two together. */}
                <g
                  class="mp-north"
                  transform={`translate(${+FLOORPLAN[floor].viewBox.split(' ')[0] + 10} ${+FLOORPLAN[floor].viewBox.split(' ')[1] + 14}) scale(0.34)`}
                >
                  <path d="M 18 58 L 30 18 L 42 58 L 30 48 Z" />
                  <text x="30" y="80">N</text>
                </g>

                <g transform={`translate(0 ${FLOORPLAN[floor].offsetY})`}>
                  {/* The floorplate, under everything. */}
                  <polygon
                    class="mp-shell"
                    points={FLOORPLAN[floor].outline.map((q) => q.join(',')).join(' ')}
                  />

                  {/* ROOMS, all of them - including the fourteen hallways,
                      staircases and closets the plan does not name. Those are
                      drawn with no fill and no label, so nothing about the
                      resting plan changes, but they are here to be hovered:
                      their name is the one thing about them a reviewer cannot
                      otherwise check, and it appears when you point at the row
                      or at the space itself. */}
                  {FLOORPLAN[floor].rooms.map((r) => (
                    <path
                      class:list={['mp-room', !spot(r.id).drawn && 'is-quiet']}
                      d={path(r.points)}
                      data-kind={spot(r.id).kind}
                      data-spot={r.id}
                      style={litStyle(spot(r.id))}
                    >
                      <title>{tooltip(r.id)}</title>
                    </path>
                  ))}

                  {/* ZONES, dashed. A zone has no wall between it and its room -
                      that is what makes it a zone - so it cannot be drawn as one.
                      A dashed line is the convention for a boundary you can walk
                      straight through, which is exactly what this is. */}
                  {FLOORPLAN[floor].zones.map((z) => (
                    <path
                      class="mp-zone"
                      d={path(z.points)}
                      data-kind={spot(z.id).kind}
                      data-spot={z.id}
                      style={litStyle(spot(z.id))}
                    >
                      <title>{tooltip(z.id)}</title>
                    </path>
                  ))}

                  {/* The building. Three weights and no others; the gaps are the
                      doorways. */}
                  {LAYERS.map((layer) => (
                    <path
                      class={`mp-wall is-${layer}`}
                      d={FLOORPLAN[floor].d[layer]}
                      stroke-width={STROKE[layer]}
                    />
                  ))}

                  {/* The names, over everything, each on the author's own anchor
                      and broken on their own lines - both are fitted to the room
                      they sit in, and recomputing either would be guessing at a
                      decision somebody made with the plan in front of them. */}
                  {FLOORPLAN[floor].rooms.map((r) => (
                    <text
                      class:list={['mp-name', !spot(r.id).drawn && 'is-quiet']}
                      data-kind={spot(r.id).kind}
                      data-spot={r.id}
                      x={r.at[0]}
                      y={r.at[1]}
                      style={`font-size: ${r.size * LABEL_SCALE}px`}
                    >
                      {r.lines.map((line, i) => (
                        <tspan x={r.at[0]} dy={i ? r.size * LABEL_SCALE : 0}>
                          {line}
                        </tspan>
                      ))}
                    </text>
                  ))}

                  {FLOORPLAN[floor].zones.map((z) => (
                    <text
                      class="mp-zone-name"
                      data-kind={spot(z.id).kind}
                      data-spot={z.id}
                      x={z.at[0]}
                      y={z.at[1]}
                      style={`font-size: ${z.size * LABEL_SCALE}px`}
                    >
                      {z.lines.map((line, i) => (
                        <tspan x={z.at[0]} dy={i ? z.size * LABEL_SCALE * 1.15 : 0}>
                          {line}
                        </tspan>
                      ))}
                    </text>
                  ))}
                </g>
              </svg>
            </div>

            {/* The list beside the plan rather than under it, so one can be read
                against the other without either leaving the screen. It scrolls
                inside its own box for the same reason: a floor is 26 to 31 rows
                and the plan would otherwise be a long way up the page. */}
            <div class="mp-list">
              <div class="mp-list-head">
                <span>Spaces</span>
                <span>
                  {SPOTS.filter((sp) => sp.floor === floor && sp.shape === 'room').length} rooms ·{' '}
                  {SPOTS.filter((sp) => sp.floor === floor && sp.shape === 'zone').length} zones
                </span>
              </div>

              <div class="mp-list-scroll">
                <table class="mp-table">
                  <thead>
                    <tr>
                      <th class="mp-th-code">Code</th>
                      <th>Space</th>
                      <th>Studio</th>
                    </tr>
                  </thead>
                  <tbody>
                    {rowsOn(floor).map((sp) => (
                      <tr
                        data-spot={sp.id}
                        data-shape={sp.shape}
                        style={litStyle(sp)}
                        class:list={[!sp.drawn && 'is-unlabelled', sp.studios.length > 0 && 'has-studio']}
                      >
                        <td class="mp-code">{sp.id}</td>
                        <td class="mp-space">
                          <span class="mp-space-name">{sp.name}</span>
                          {/* The fourteen hallways, staircases and closets are drawn
                              as walls and left unnamed on the plan, so a reviewer
                              looking for CLOSET would not find one. Said here rather
                              than left to be noticed. */}
                          {!sp.drawn && <span class="mp-flag">not labelled</span>}
                        </td>
                        <td class="mp-who">
                          {sp.studios.length === 0 ? (
                            <span class="mp-dash">—</span>
                          ) : (
                            sp.studios.map((slug) => {
                              const st = SPACE_STUDIO_BY_SLUG.get(slug)!;
                              return (
                                <span class="mp-who-one">
                                  <img src={st.badge} alt="" width="22" height="22" />
                                  {st.name}
                                </span>
                              );
                            })
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </section>
      ))
    }

    {
      ORPHANS.length > 0 && (
        <section class="mp-todo">
          <h2>Still to place</h2>
          <ul>
            <li>
              <b>{ORPHANS.map((st) => st.name).join(', ')}</b> — no space on the plan
              claims {ORPHANS.length === 1 ? 'this studio' : 'these studios'} yet.
            </li>
          </ul>
        </section>
      )
    }

    {/* The counts moved into the Room data heading, where they are a count of
        the table underneath them. Said in both places they disagreed: this one
        was the 29 rooms the plan labels, that one is all 43. */}
    <p class="mp-note">
      Every name, shape and label position above comes from{' '}
      <b>data/floorplan.svg</b>, which is drawn by hand rather than traced.{' '}
      <b>data/rooms.ts</b> adds the one thing the drawing cannot know: which
      studios work where.
    </p>
  </main>
</Base>

<style>
  .mp-floor + .mp-floor {
    margin-top: 3.25rem;
  }

  .mp-floor-h {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin-bottom: 1rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--color-sm-ink);
  }

  .mp-floor-h span {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-sm-slate);
  }

  /* The plan takes the room it needs and the list takes what is left, with a
     floor under the list: below about 18rem the studio column starts wrapping
     its own names, and a wrapped name is the one thing in here that has to be
     read straight.

     The cap is 26rem and was 24, which is a measured pixel rather than a
     preference. The studio column takes max-content - the widest of it is
     "screen printing" with its badge, 140px - on every row, so what is left for
     a name is fixed however wide the window gets. At 24rem "Utility Closet"
     plus its NOT LABELLED tag needed 173px of a 172px box and wrapped, alone
     among fifty-seven rows. The extra 2rem costs the plan 5% of its width and
     leaves every row a line to itself. */
  .mp-pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 26rem);
    gap: 1.25rem;
    align-items: start;
  }

  /* Three tones, darkest outwards: the ground outside the building, the floor
     inside it, then the rooms once there are any. That ordering is what makes a
     corridor read as a corridor - lighter than the street and darker than a
     room, which is exactly what it is. */
  .mp-plan-wrap {
    padding: 0.75rem;
    background: #e3e7e4;
    border-radius: 12px;
  }

  .mp-plan {
    display: block;
    width: 100%;
    height: auto;
  }

  .mp-north path {
    fill: var(--color-sm-slate);
    opacity: 0.55;
  }

  .mp-north text {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    text-anchor: middle;
    fill: var(--color-sm-slate);
    opacity: 0.55;
  }

  .mp-shell {
    fill: var(--color-sm-mist);
  }

  /* ------------------------------------------------------------ colour ---

     Three tones, and no colour at rest:

       outside the building   the wrap's own grey
       the floor              mist - and a corridor is left to show it, because
                              a corridor IS the leftover floor
       a room                 white, a plate standing on that floor

     The studios used to be a green wash, which was the plan's one piece of
     colour and its key. It came off on 2026-10-06, once the list beside it and
     the hover between them did that job better: the wash said "a studio is in
     here somewhere" to within a whole room, where hovering a row says exactly
     which space and in that studio's own colour. Twenty tinted spaces out of
     fifty-seven is a lot of green to carry for a vaguer answer, and the plan is
     easier to read as a building without it.

     So colour on this plan now means one thing only - "this is the space you
     are pointing at" - and the drawing is the walls and the names.

     The drawing's own fills are a map-colouring - the two woodshops have
     different colours and so do the two ceramics rooms - which is useful while
     drawing and unreadable once finished, so they are not used either.

     Two rooms of the same kind side by side do not merge, because the wall
     between them is drawn in ink. The wall is the separator. */
  /* "all" rather than the default, which only hits painted pixels: a corridor
     and a closet are both fill-less, so without this they are the two kinds of
     space you cannot point at - and one of them is the kind whose name only
     exists on hover. */
  .mp-room {
    fill: var(--color-sm-paper);
    pointer-events: all;
    transition: fill 140ms ease;
  }

  /* No fill at all: the floorplate shows through, so corridors read as the
     space between rooms rather than as more rooms. */
  .mp-room[data-kind='circulation'] {
    fill: none;
  }

  /* The spaces the plan does not name - hallways, staircases, closets, the
     Landing. Rendered and invisible: no fill, so the resting plan is exactly
     what it was when they were left out of the markup altogether, and the
     walls still say where they are. What they gain is a hit target and a name
     that arrives on hover. Above the lit rules, so being lit beats being
     quiet. */
  .mp-room.is-quiet {
    fill: none;
  }

  /* A zone has no wall between it and its room - that is what makes it a zone -
     so it cannot be drawn as one. Dashes are the convention for a boundary you
     walk straight through. In drawing units, so the dash keeps its size on the
     plan however the page is scaled. */
  .mp-zone {
    fill: none;
    stroke: var(--color-sm-slate);
    stroke-width: 1.1;
    stroke-dasharray: 4 3;
    opacity: 0.55;
    /* "all" rather than the default, which only hits painted pixels: a zone
       with no fill would then be hoverable along its dashes and nowhere else.
       It sits over its room, so inside a zone the zone answers - which is the
       more specific answer, and the one the list is keyed to. */
    pointer-events: all;
  }

  /* A zone that houses a studio keeps its green dashes and has lost its tint
     with the rooms. The boundary is still the thing worth saying - it is what
     lets the Megastudio show electronics at one end and screen printing at the
     other - and a dashed outline says it without filling a fifth of the floor.
     It sits a step stronger than a plain zone's slate dashes. */
  .mp-zone[data-kind='studio'] {
    stroke: var(--color-sm-green);
    opacity: 0.85;
  }

  /* ------------------------------------------------------------ labels ---

     Uppercase and tracked, which is the floorplan convention and stays legible
     at sizes where a lowercase name would not. Three weights, so a broom
     cupboard stops shouting as loudly as the Megastudio. */
  .mp-name {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-anchor: middle;
    text-transform: uppercase;
    fill: var(--color-sm-ink);
    pointer-events: none;
    transition: opacity 140ms ease;
  }

  /* Circulation names itself and then gets out of the way. You read "hallway"
     once to confirm it is a hallway and never look at it again. */
  .mp-name[data-kind='circulation'] {
    font-weight: 600;
    fill: var(--color-sm-slate);
    opacity: 0.8;
  }

  /* A name that is not on the plan until you ask for it. Fourteen of these
     would be most of the ink on the floor and none of the answer - but a name
     nobody can see is also a name nobody can check, which is what this page is
     for. So it is drawn and transparent, and the hover brings it in.

     It has to sit between the circulation rule and the lit one: all three weigh
     the same once Astro has scoped them, so source order is the whole
     arbitration. */
  .mp-name.is-quiet {
    opacity: 0;
  }

  /* A zone label has to be tellable from a room's at a glance, and until
     2026-10-06 the only differences were a weight and a shade - both of which
     are invisible when the two names are not side by side.

     So the distinction is CASE, which the eye reads before it reads anything
     else: a room is uppercase, a zone is upper-and-lower. It is the plan
     convention for a space inside a space, it is more legible at 7 units than
     caps are because lowercase has distinctive shapes, and it survives being
     the only label you can see.

     Italic is the drawing's own answer - the author sets `font-style="italic"`
     on both zone-label groups and nothing else - so it comes along, with the
     weight dropped further and the tracking taken back off, because tracking is
     for caps.

     (Figtree ships no italic file, so this is a synthesised oblique. Checked
     rather than assumed: at these sizes it is a clean slant, because the shapes
     are small and the stroke is even.) */
  .mp-zone-name {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-anchor: middle;
    fill: var(--color-sm-slate);
    pointer-events: none;
  }

  .mp-zone-name[data-kind='studio'] {
    fill: var(--color-sm-green-dark);
  }

  /* The building, and the only thing on the plan drawn in ink. If it is dark
     you cannot walk through it - except the stairs, which are drawn lightest of
     the three for exactly that reason: a staircase is a thing you walk on.

     The weights are the drawing's own (6 / 3 / 1.5) and are set per path from
     the data, so a redrawn floorplan changes them by being redrawn.

     `square` caps are the drawing's too, and overriding them to `butt` was a
     mistake worth recording. The argument was that a square cap overshoots by
     half a stroke at every subpath end, and every subpath end here is either a
     door jamb or a corner - so butt caps keep the doorways exactly as the path
     data states them. True, and it misses two things.

     Ten corners on this plan are formed by two SEPARATE subpaths meeting at a
     point, including the downstairs building's own top-left. A mitre join only
     closes a corner inside one subpath; between two, butt caps leave a notch of
     half a stroke square, and the plan looks like it was drawn with a shaky
     hand. Square caps fill exactly that notch - that is what the cap is for.

     And the doorways were never narrowed: the author drew the gaps with square
     caps switched on, so the opening they designed is the gap MINUS the caps.
     Butt caps made every interior door 3 units wider than intended, not
     correct. The gap is 18.4, the cap takes 1.5 from each side, the door is
     15.4, and that is the drawing's door. */
  .mp-wall {
    fill: none;
    stroke: var(--color-sm-ink);
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  /* The stairs recede. Same ink family, so they still read as built rather than
     as annotation, but they are never the thing you are trying to find. */
  .mp-wall.is-stairs {
    stroke: var(--color-sm-slate);
    opacity: 0.6;
  }

  /* ------------------------------------------------- one lit at a time ---

     Hovering either half lights the same space in the other, which is the whole
     reason the list sits beside the plan rather than under it. Every one of
     these rules has to sit BELOW the fills it overrides: .mp-room.is-lit and
     .mp-room[data-kind='studio'] both weigh (0,2,0), so source order alone
     decides which fill wins.

     It is a fill and never a stroke. A stroke that thickens moves the wall it
     is drawn on, and the room appears to twitch under the cursor.

     A space that IS a studio lights in that studio's own colour, which is what
     makes the badge in the list and the shape on the plan one object. Anything
     else - a corridor, a kitchen, a room that merely contains studios - falls
     back to grey through the var()'s own default.

     That fallback was the brand green until 2026-10-06 and grey is the better
     answer, because the green was saying something. Fifteen of the fifty-seven
     spaces have no studio at all, and lighting them in the one colour this site
     uses to mean "a studio" made the plan's loudest signal the one thing it is
     not about. Grey means only "this is what you are pointing at", which is all
     a hover on the kitchen has to say.

     It is slate rather than ink, so it stays clear of the ??? studio, which is
     ink and has every right to be the darker of the two - something does work
     in the Fume Room.

     The fill is heavier than the resting tint, and it has to be: these are
     fourteen brand colours of wildly different lightness, and woodshop's gold
     at the 0.2 the resting studio tint uses is barely a change against white
     paper. At 0.45 the palest of them still registers and the darkest - the
     leatherworking brown - is still something ink can be read over. */
  .mp-room.is-lit {
    fill: var(--studio, var(--color-sm-slate));
    fill-opacity: 0.45;
  }

  .mp-zone.is-lit {
    fill: var(--studio, var(--color-sm-slate));
    fill-opacity: 0.5;
    opacity: 1;
  }

  /* The name lights with the room. On a small room the fill alone is easy to
     miss, and the name is what you are looking for anyway.

     Ink rather than the studio's colour, and that was measured rather than
     chosen: eight of the fourteen fail 4.5:1 as type on white - woodshop's gold
     manages 1.76 - and here they would be type on a wash of themselves, which
     is worse. Ink reads on all fourteen. */
  .mp-name.is-lit,
  .mp-zone-name.is-lit {
    fill: var(--color-sm-ink);
    opacity: 1;
  }

  /* ---------------------------------------------------------- the data --- */

  /* A card rather than a bare table, because beside a plan on a tinted ground
     a column of hairlines with no edge reads as something that fell off the
     page. The radius clips the scroller, which is why the overflow is here as
     well as on the child. */
  .mp-list {
    display: flex;
    flex-direction: column;
    min-width: 0;
    max-height: 30rem;
    overflow: hidden;
    border: 1px solid var(--color-sm-line);
    border-radius: 12px;
    background: #fff;
  }

  .mp-list-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    flex: 0 0 auto;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--color-sm-line);
    background: var(--color-sm-mist);
    font-family: var(--font-display);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-sm-slate);
  }

  .mp-list-scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    /* A list that scrolls inside a page that also scrolls hands the page its
       overscroll at either end, so reaching the bottom of a floor's list jumps
       the whole page away from the plan it is being read against. */
    overscroll-behavior: contain;
  }

  .mp-lede {
    max-width: 68ch;
    margin: 0 0 2rem;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-sm-slate);
  }

  .mp-lede b {
    font-weight: 600;
    color: var(--color-sm-ink-2);
  }

  .mp-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
  }

  /* Hairline rows rather than a bordered grid: this is a list to read down,
     and the one vertical relationship that matters - a zone under its room -
     is said by the indent instead. */
  /* The header has to survive the scroll, and a sticky cell cannot hold a
     border - the row it is pinned over slides under it and the border goes
     with the paint. An inset shadow draws inside the cell instead. */
  .mp-table th {
    position: sticky;
    top: 0;
    z-index: 1;
    padding: 0.45rem 0.6rem;
    background: #fff;
    box-shadow: inset 0 -1px 0 var(--color-sm-line);
    font-family: var(--font-display);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-align: left;
    color: var(--color-sm-slate);
  }

  .mp-table td {
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--color-sm-line);
    vertical-align: middle;
  }

  .mp-table tr:last-child td {
    border-bottom: 0;
  }

  /* The green says the same thing here that it says on the plan: a studio works
     in this space. It is the only tint on either, so the two can be read
     against each other. */
  .mp-table tr.has-studio {
    background: color-mix(in srgb, var(--color-sm-green-mid) 8%, transparent);
  }

  .mp-th-code,
  .mp-code {
    width: 1%;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    font-size: 0.8125rem;
    color: var(--color-sm-slate);
  }

  .mp-space-name {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-sm-ink);
  }

  /* A zone is indented under its room and set a step down, so the pair reads as
     "this room, this part of it" - the same relationship the dashed boundary
     draws on the plan. */
  .mp-table tr[data-shape='zone'] .mp-space-name {
    display: inline-block;
    padding-left: 1.15rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-sm-ink-2);
  }

  .mp-table tr[data-shape='zone'] .mp-space-name::before {
    content: '└';
    display: inline-block;
    width: 1.15rem;
    margin-left: -1.15rem;
    font-weight: 400;
    color: var(--color-sm-slate);
    opacity: 0.55;
  }

  /* It wraps as a unit or not at all. In the narrow column beside the plan,
     "Utility Closet NOT LABELLED" broke between the two words of the tag and
     left LABELLED alone on a second line, which reads as a second fact about
     the room rather than as the end of the first. */
  .mp-flag {
    display: inline-block;
    margin-left: 0.5rem;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-sm-slate);
    opacity: 0.8;
  }

  /* The unlabelled spaces stay in the list and recede in it - they are real
     rooms with real names and somebody still has to say whether the names are
     right, but they are not what the plan is for. */
  .mp-table tr.is-unlabelled .mp-space-name {
    font-weight: 500;
    color: var(--color-sm-slate);
  }

  /* A little more room on the right than the other cells, because an overlay
     scrollbar appears over the content rather than beside it and this is the
     column it would land on. */
  .mp-who {
    width: 1%;
    padding-right: 0.95rem;
    white-space: nowrap;
  }

  .mp-who-one {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    color: var(--color-sm-green);
  }

  .mp-who-one + .mp-who-one {
    margin-left: 0.7rem;
  }

  .mp-who-one img {
    flex: 0 0 auto;
  }

  .mp-dash {
    color: var(--color-sm-line);
  }

  /* Below .has-studio, which it has to beat on a row that has one. Same rule
     as the plan: the studio's own colour, grey for everything else. Lighter
     than the plan's wash, because a table row is a long thin band of it next
     to type rather than a shape on a drawing. */
  .mp-table tr.is-lit {
    background: color-mix(in srgb, var(--studio, var(--color-sm-slate)) 26%, transparent);
  }

  .mp-todo {
    margin-top: 3rem;
    padding: 1.1rem 1.25rem;
    background: var(--color-sm-mist);
    border-left: 4px solid var(--color-sm-green-mid);
    border-radius: 0 10px 10px 0;
  }

  .mp-todo h2 {
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-sm-slate);
  }

  .mp-todo ul {
    display: grid;
    gap: 0.45rem;
  }

  .mp-todo li {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-sm-ink-2);
  }

  .mp-note {
    max-width: 62ch;
    margin-top: 2.5rem;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-sm-slate);
  }

  /* Side by side needs about 44rem for the plan and 18 for the list. Under
     that they stack, and the list comes down off the plan's height to
     something that still leaves the plan on screen above it. */
  @media (max-width: 62rem) {
    .mp-pair {
      grid-template-columns: minmax(0, 1fr);
    }

    .mp-list {
      max-height: 24rem;
    }
  }

  @media (max-width: 40rem) {
    /* The plan is the one thing here that cannot usefully shrink any further,
       so at phone width it gets the sheet's own gutters back. */
    .mp-plan-wrap {
      margin: 0 calc(var(--pad-x) * -1);
      padding: 0.6rem;
      border-radius: 0;
    }

    /* The badge is the first thing to go: at this width the name is what is
       being checked and the picture is 22px of decoration beside it. */
    .mp-who-one img {
      display: none;
    }

    .mp-table th,
    .mp-table td {
      padding-left: 0.35rem;
      padding-right: 0.35rem;
    }
  }
</style>

<script>
  /* A name may not be wider than the room it names.

     The sizes are the drawing's own and are left alone - they were set with the
     plan in front of somebody, and in drawing units, so they hold at every page
     size. What the author cannot check from inside a design tool is how the
     name sets in OUR face: the drawing is Archivo Narrow and the site is
     Figtree, which is wider. LABEL_SCALE covers the difference for forty-two of
     the forty-three, and "Sewing Studio" is the one it does not - 81 units of
     type in a 74-unit room, which puts three units of it through the wall at
     each end.

     So this only ever SHRINKS, and only the labels that need it. It measures
     rather than estimates - getBBox is the real shaped text, in user units, so
     one pass at load holds at every size the plan is drawn at. A general
     re-layout would be guessing at a decision somebody already made; a cap is
     not. */
  for (const svg of document.querySelectorAll<SVGSVGElement>('svg.mp-plan')) {
    for (const label of svg.querySelectorAll<SVGTextElement>('text[data-spot]')) {
      const room = svg.querySelector<SVGGraphicsElement>(`path[data-spot="${label.dataset.spot}"]`);
      if (!room) continue;
      const ink = label.getBBox();
      const walls = room.getBBox();

      // The room's width is not the room the LABEL has. These are centred on
      // the author's own anchor and shrinking the type pulls both ends in
      // towards it, so what a name can use is twice its smaller side - which is
      // the whole width only when the anchor happens to sit in the middle. It
      // does not on an L-shaped room: the downstairs west staircase is anchored
      // 13 units from its left wall and 26 from its right, and measured against
      // the full 39 "Stairs" fits and still crosses the wall.
      const centre = ink.x + ink.width / 2;
      // Two units of air at each end, so a capped name does not simply touch
      // the wall instead of crossing it.
      const room_ = 2 * Math.min(centre - walls.x, walls.x + walls.width - centre) - 4;
      if (ink.width > room_ && room_ > 0) {
        const size = parseFloat(getComputedStyle(label).fontSize);
        label.style.fontSize = `${(size * room_) / ink.width}px`;
      }
    }
  }

  /* Hover one, light the other.

     Delegated per floor rather than per element: a pair is one plan and about
     thirty rows, and the plan's own rooms come and go with the drawing. Scoped
     to the pair as well, so the upstairs list cannot light a downstairs room.

     The names on the plan are pointer-events: none, so a label hands the hover
     to the room underneath it rather than being a dead patch in the middle of
     the space it names. They still carry data-spot, because they light too. */
  for (const pair of document.querySelectorAll<HTMLElement>('.mp-pair')) {
    const paint = (id: string | null) => {
      for (const el of pair.querySelectorAll('.is-lit')) el.classList.remove('is-lit');
      if (id) for (const el of pair.querySelectorAll(`[data-spot="${id}"]`)) el.classList.add('is-lit');
    };

    pair.addEventListener('pointerover', (e) => {
      paint((e.target as Element).closest('[data-spot]')?.getAttribute('data-spot') ?? null);
    });
    pair.addEventListener('pointerleave', () => paint(null));
  }
</script>
