---
/**
 * Where everything is: the building, one floor at a time.
 *
 * The plan is drawn from data/floorplan.svg rather than being an image with
 * hotspots over it. That costs an extractor and buys three things an image
 * cannot: the walls are geometry (so they stay sharp at any size and the plan
 * can be measured), the floorplate is derived from the drawing's own outline,
 * and anything placed on top - rooms, studios, a route - sits in the same
 * coordinate system as the building rather than being pinned to pixels.
 *
 * STRIPPED BACK on 2026-10-05. The page used to carry a zone layer, a label
 * layer, two switches, a room list per floor and a studio index. All of it was
 * driving off room shapes that were thrown away with the old traced floorplan,
 * so every one of those was a control over an empty layer or a list beside a
 * drawing it could not point at. They come back as the rooms are placed against
 * this drawing, and not before: a switch that toggles nothing is worse than no
 * switch, because it says the feature is broken rather than absent.
 *
 * data/rooms.ts and data/studios.ts are untouched - the names, codes, tape
 * colours, studio assignments and open questions are all still there, waiting
 * for geometry to hang them on.
 */
import Base from '../layouts/Base.astro';
import { toolById, pageTitle } from '../data/tools';
import { OPEN_QUESTIONS, SPOTS, placeOf, spotsForStudio, studiosWithoutSpot, undrawnOn } from '../data/rooms';
import { FLOORPLAN, FLOORS, STROKE, type Floor, type Layer } from '../data/floorplan';
import { STUDIOS, STUDIO_BY_SLUG } from '../data/studios';

const TOOL = toolById('map');

/**
 * The drawing's three layers, in the order they are painted.
 *
 * Stairs first, so the walls land on top of them. A staircase runs right up to
 * the wall it is enclosed by, and drawn over the top its treads cross the wall
 * and poke out the other side - which reads as the stair being in front of the
 * building rather than inside it.
 */
const LAYERS: Layer[] = ['stairs', 'exterior', 'interior'];

/** What each floor is called on the page. The geometry is the drawing's. */
const FLOOR_NAME: Record<Floor, { title: string; sub: string }> = {
  upstairs: { title: 'Upstairs', sub: '2nd floor' },
  downstairs: { title: 'Downstairs', sub: '1st floor' },
};

const spotsOn = (floor: Floor) => SPOTS.filter((s) => s.floor === floor);
const spot = (id: string) => SPOTS.find((s) => s.id === id)!;

/**
 * The drawing's label sizes were set in Archivo Narrow and the site sets
 * Figtree, which is wider - so a name tuned to its room in one face overflows
 * it in the other. Measured rather than guessed: see *Labels* in CLAUDE.md.
 */
const LABEL_SCALE = 0.88;
const path = (points: readonly (readonly number[])[]) =>
  `M${points.map((p) => p.join(' ')).join(' L')} Z`;
const ORPHANS = studiosWithoutSpot();
---

<Base title={pageTitle(TOOL)} description={TOOL.blurb} shellWidth="72rem">
  <div class="sm-crumb-row">
    <a class="sm-back" href="/">← All tools</a>
    <span class="sm-stamp">Interbay · 2 floors</span>
  </div>

  <main class="sm-sheet">
    <header class="sm-hero">
      <h1 class="sm-h1">{TOOL.name}</h1>
      <p class="sm-lead">{TOOL.blurb}</p>
    </header>

    {
      FLOORS.map((floor) => (
        <section class="mp-floor" data-floor={floor}>
          <h2 class="mp-floor-h">
            {FLOOR_NAME[floor].title}
            <span>{FLOOR_NAME[floor].sub}</span>
          </h2>

          <div class="mp-plan-wrap">
            <svg
              class="mp-plan"
              viewBox={FLOORPLAN[floor].viewBox}
              role="img"
              aria-label={`Floorplan of the ${FLOOR_NAME[floor].title.toLowerCase()} floor`}
            >
              {/* North is up on the drawing, so it is up here. The one thing on
                  the plan that is not the building, and it earns the space:
                  every instruction anyone gives in here is "past the woodshop",
                  not "north", so the arrow is what ties the two together. */}
              <g
                class="mp-north"
                transform={`translate(${+FLOORPLAN[floor].viewBox.split(' ')[0] + 10} ${+FLOORPLAN[floor].viewBox.split(' ')[1] + 14}) scale(0.34)`}
              >
                <path d="M 18 58 L 30 18 L 42 58 L 30 48 Z" />
                <text x="30" y="80">N</text>
              </g>

              <g transform={`translate(0 ${FLOORPLAN[floor].offsetY})`}>
                {/* The floorplate, under everything. */}
                <polygon
                  class="mp-shell"
                  points={FLOORPLAN[floor].outline.map((q) => q.join(',')).join(' ')}
                />

                {/* ROOMS. The fills are the drawing's own: adjacent rooms are
                    given different colours so they can be told apart, which is
                    a map-colouring rather than a key - two woodshops do not
                    share one. Held well back, because the thing you are looking
                    for is a name and the thing that orients you is a wall. */}
                {FLOORPLAN[floor].rooms.filter((r) => spot(r.id).drawn).map((r) => (
                  <path
                    class="mp-room"
                    d={path(r.points)}
                    data-kind={spot(r.id).kind}
                    data-via={spot(r.id).studios.length > 0 ? 'own' : 'zone'}
                    data-spot={r.id}
                  >
                    <title>{r.name}</title>
                  </path>
                ))}

                {/* ZONES, dashed. A zone has no wall between it and its room -
                    that is what makes it a zone - so it cannot be drawn as one.
                    A dashed line is the convention for a boundary you can walk
                    straight through, which is exactly what this is. */}
                {FLOORPLAN[floor].zones.map((z) => (
                  <path
                    class="mp-zone"
                    d={path(z.points)}
                    data-kind={spot(z.id).kind}
                    data-spot={z.id}
                  >
                    <title>{z.name}</title>
                  </path>
                ))}

                {/* The building. Three weights and no others; the gaps are the
                    doorways. */}
                {LAYERS.map((layer) => (
                  <path
                    class={`mp-wall is-${layer}`}
                    d={FLOORPLAN[floor].d[layer]}
                    stroke-width={STROKE[layer]}
                  />
                ))}

                {/* The names, over everything, each on the author's own anchor
                    and broken on their own lines - both are fitted to the room
                    they sit in, and recomputing either would be guessing at a
                    decision somebody made with the plan in front of them. */}
                {FLOORPLAN[floor].rooms.filter((r) => spot(r.id).drawn).map((r) => (
                  <text
                    class="mp-name"
                    data-kind={spot(r.id).kind}
                    x={r.at[0]}
                    y={r.at[1]}
                    style={`font-size: ${r.size * LABEL_SCALE}px`}
                  >
                    {r.lines.map((line, i) => (
                      <tspan x={r.at[0]} dy={i ? r.size * LABEL_SCALE : 0}>
                        {line}
                      </tspan>
                    ))}
                  </text>
                ))}

                {FLOORPLAN[floor].zones.map((z) => (
                  <text
                    class="mp-zone-name"
                    data-kind={spot(z.id).kind}
                    x={z.at[0]}
                    y={z.at[1]}
                    style={`font-size: ${z.size * LABEL_SCALE}px`}
                  >
                    {z.lines.map((line, i) => (
                      <tspan x={z.at[0]} dy={i ? z.size * LABEL_SCALE * 1.15 : 0}>
                        {line}
                      </tspan>
                    ))}
                  </text>
                ))}
              </g>
            </svg>
          </div>
          <ul class="mp-spots">
            {spotsOn(floor).filter((sp) => sp.shape === 'room' && sp.drawn).map((sp) => (
              <li class="mp-spot" data-kind={sp.kind} data-spot={sp.id}>
                <span class="mp-spot-id">{sp.id}</span>
                <span class="mp-spot-body">
                  <span class="mp-spot-name">{sp.name}</span>
                  {spotsOn(floor)
                    .filter((z) => z.shape === 'zone' && z.room === sp.id)
                    .map((z) => (
                      <span class="mp-spot-zone">{z.name}</span>
                    ))}
                  {[...sp.studios, ...spotsOn(floor).filter((z) => z.room === sp.id).flatMap((z) => z.studios)]
                    .map((slug) => (
                      <span class="mp-tag">
                        <img src={STUDIO_BY_SLUG.get(slug)!.icon} alt="" width="16" height="16" />
                        {STUDIO_BY_SLUG.get(slug)!.name}
                      </span>
                    ))}
                  {sp.note && <i class="mp-spot-note">{sp.note}</i>}
                </span>
              </li>
            ))}
          </ul>

          {/* Said once, rather than fourteen times on the drawing. The walls
              are still there - they come from the wall layer, not from these
              shapes - so a closet is a walled box and a staircase has its
              treads. Only the fill and the name are gone. */}
          <p class="mp-undrawn">
            Also on this floor: {undrawnOn(floor)} — their walls are on the plan,
            but they are not named.
          </p>
        </section>
      ))
    }

    {/* THE STUDIOS. A studio is not a room - it is wherever its work happens,
        which can be one room, two rooms, a zone inside somebody else's room, or
        nothing yet. Listing them separately from the floors is what lets that
        be true without the plan having to pretend otherwise. */}
    <section class="mp-studios">
      <h2 class="mp-floor-h">
        Studios<span>{STUDIOS.length} in all</span>
      </h2>

      <ul class="mp-studio-list">
        {
          STUDIOS.map((st) => {
            const where = spotsForStudio(st.slug);
            return (
              <li
                class:list={['mp-studio', where.length === 0 && 'is-homeless']}
                style={`--studio: ${st.colour}`}
                data-studios={st.slug}
              >
                <img class="mp-badge" src={st.badge} alt="" width="40" height="40" />
                <span class="mp-studio-body">
                  <span class="mp-studio-name">{st.name}</span>
                  {where.length === 0 ? (
                    <span class="mp-studio-where">no space yet</span>
                  ) : (
                    where.map((sp) => (
                      <span class="mp-studio-where">
                        {placeOf(sp)}
                        <i>{sp.floor === 'upstairs' ? '2nd floor' : '1st floor'}</i>
                      </span>
                    ))
                  )}
                </span>
              </li>
            );
          })
        }
      </ul>
    </section>

    {
      (ORPHANS.length > 0 || OPEN_QUESTIONS.length > 0) && (
        <section class="mp-todo">
          <h2>Still to confirm</h2>
          <ul>
            {ORPHANS.length > 0 && (
              <li>
                <b>{ORPHANS.map((st) => st.name).join(', ')}</b> — no space on the plan
                claims {ORPHANS.length === 1 ? 'this studio' : 'these studios'} yet.
              </li>
            )}
            {OPEN_QUESTIONS.map((sp) => (
              <li>
                <b>{sp.name}</b> — {sp.note}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="mp-note">
      {SPOTS.filter((sp) => sp.shape === 'room' && sp.drawn).length} rooms and
      {' '}{SPOTS.filter((sp) => sp.shape === 'zone').length} zones, named and shaped by
      <b>data/floorplan.svg</b>. <b>data/rooms.ts</b> adds only what the drawing
      cannot know: which studios work where, and what is still unsettled.
    </p>
  </main>
</Base>

<style>
  .mp-floor + .mp-floor {
    margin-top: 3.25rem;
  }

  .mp-floor-h {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin-bottom: 1rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--color-sm-ink);
  }

  .mp-floor-h span {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-sm-slate);
  }

  /* Three tones, darkest outwards: the ground outside the building, the floor
     inside it, then the rooms once there are any. That ordering is what makes a
     corridor read as a corridor - lighter than the street and darker than a
     room, which is exactly what it is. */
  .mp-plan-wrap {
    padding: 0.75rem;
    background: #e3e7e4;
    border-radius: 12px;
  }

  .mp-plan {
    display: block;
    width: 100%;
    height: auto;
  }

  .mp-north path {
    fill: var(--color-sm-slate);
    opacity: 0.55;
  }

  .mp-north text {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    text-anchor: middle;
    fill: var(--color-sm-slate);
    opacity: 0.55;
  }

  .mp-shell {
    fill: var(--color-sm-mist);
  }

  /* ------------------------------------------------------------ colour ---

     Four tones, and each one says something:

       outside the building   the wrap's own grey
       the floor              mist - and a corridor is left to show it, because
                              a corridor IS the leftover floor
       a room                 white, a plate standing on that floor
       a studio               the brand wash, the only tint on the plan

     That last line is the whole scheme. Somebody opens this map to find where
     a discipline lives, so the spaces that house one are the only coloured
     thing on it and everything else gets out of the way. The drawing's own
     fills were a map-colouring - the two woodshops have different colours and
     so do the two ceramics rooms - which is useful while drawing and
     unreadable once finished.

     Two rooms of the same kind side by side do not merge, because the wall
     between them is drawn in ink. The wall is the separator; the fill is the
     meaning. */
  .mp-room {
    fill: var(--color-sm-paper);
    transition: fill 140ms ease;
  }

  /* The brand green at a fraction, rather than --color-sm-wash. Wash is a 7%
     step off white and simply does not register at this size - the first
     version of this looked like a plan with no colour on it at all. Measured
     against paper rather than judged: the tint has to survive being one room
     among forty-three at a quarter of the page. */
  .mp-room[data-kind='studio'] {
    fill: var(--color-sm-green-mid);
    fill-opacity: 0.2;
  }

  /* A room whose studios are all in its ZONES gets a hint rather than the full
     tint. The Big Room is enormous and its one studio is the leatherworking
     corner; the Fab Lab's are the laser and 3D printing ends. Tinted the same
     as the Sewing Studio, which is a studio wall to wall, those rooms made the
     plan read as though the whole floor was a shop. Light room, strong zone: the
     room says making happens in here, the zone says where. */
  .mp-room[data-kind='studio'][data-via='zone'] {
    fill-opacity: 0.08;
  }

  /* No fill at all: the floorplate shows through, so corridors read as the
     space between rooms rather than as more rooms. */
  .mp-room[data-kind='circulation'] {
    fill: none;
  }

  /* A zone has no wall between it and its room - that is what makes it a zone -
     so it cannot be drawn as one. Dashes are the convention for a boundary you
     walk straight through. In drawing units, so the dash keeps its size on the
     plan however the page is scaled. */
  .mp-zone {
    fill: none;
    stroke: var(--color-sm-slate);
    stroke-width: 1.1;
    stroke-dasharray: 4 3;
    opacity: 0.55;
    pointer-events: none;
  }

  /* A zone that houses a studio is tinted a step past its room and dashed in
     green, which is what lets the Megastudio show electronics at one end and
     screen printing at the other without either claiming the room. */
  .mp-zone[data-kind='studio'] {
    fill: var(--color-sm-green-mid);
    fill-opacity: 0.26;
    stroke: var(--color-sm-green);
    opacity: 0.85;
  }

  /* ------------------------------------------------------------ labels ---

     Uppercase and tracked, which is the floorplan convention and stays legible
     at sizes where a lowercase name would not. Three weights, so a broom
     cupboard stops shouting as loudly as the Megastudio. */
  .mp-name {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-anchor: middle;
    text-transform: uppercase;
    fill: var(--color-sm-ink);
    pointer-events: none;
  }

  /* Circulation names itself and then gets out of the way. You read "hallway"
     once to confirm it is a hallway and never look at it again. */
  .mp-name[data-kind='circulation'] {
    font-weight: 600;
    fill: var(--color-sm-slate);
    opacity: 0.8;
  }

  /* A zone label sits a step under its room's, in weight and in colour, so the
     pair reads as "this room, this part of it" rather than as two rooms. */
  .mp-zone-name {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-anchor: middle;
    text-transform: uppercase;
    fill: var(--color-sm-slate);
    pointer-events: none;
  }

  .mp-zone-name[data-kind='studio'] {
    fill: var(--color-sm-green-dark);
  }

  /* The building, and the only thing on the plan drawn in ink. If it is dark
     you cannot walk through it - except the stairs, which are drawn lightest of
     the three for exactly that reason: a staircase is a thing you walk on.

     The weights are the drawing's own (6 / 3 / 1.5) and are set per path from
     the data, so a redrawn floorplan changes them by being redrawn.

     `square` caps are the drawing's too, and overriding them to `butt` was a
     mistake worth recording. The argument was that a square cap overshoots by
     half a stroke at every subpath end, and every subpath end here is either a
     door jamb or a corner - so butt caps keep the doorways exactly as the path
     data states them. True, and it misses two things.

     Ten corners on this plan are formed by two SEPARATE subpaths meeting at a
     point, including the downstairs building's own top-left. A mitre join only
     closes a corner inside one subpath; between two, butt caps leave a notch of
     half a stroke square, and the plan looks like it was drawn with a shaky
     hand. Square caps fill exactly that notch - that is what the cap is for.

     And the doorways were never narrowed: the author drew the gaps with square
     caps switched on, so the opening they designed is the gap MINUS the caps.
     Butt caps made every interior door 3 units wider than intended, not
     correct. The gap is 18.4, the cap takes 1.5 from each side, the door is
     15.4, and that is the drawing's door. */
  .mp-wall {
    fill: none;
    stroke: var(--color-sm-ink);
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  /* The stairs recede. Same ink family, so they still read as built rather than
     as annotation, but they are never the thing you are trying to find. */
  .mp-wall.is-stairs {
    stroke: var(--color-sm-slate);
    opacity: 0.6;
  }

  /* ---------------------------------------------------------- the lists --- */

  .mp-spots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 0.15rem;
    margin-top: 1.1rem;
  }

  .mp-spot {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.45rem 0.6rem;
    border-radius: 9px;
  }

  /* The drawing's id, which is how a space is referred to in conversation and
     in rooms.ts. Monospace because it is a key rather than a word. */
  .mp-spot-id {
    flex: 0 0 auto;
    min-width: 2.1rem;
    padding: 0.1rem 0.3rem;
    border-radius: 5px;
    background: var(--color-sm-line);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.7rem;
    font-weight: 600;
    text-align: center;
    color: var(--color-sm-slate);
  }

  .mp-spot[data-kind='studio'] .mp-spot-id {
    background: var(--color-sm-wash);
    color: var(--color-sm-green-dark);
  }

  .mp-spot[data-kind='circulation'] {
    opacity: 0.68;
  }

  .mp-spot-body {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    min-width: 0;
  }

  .mp-spot-name {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-sm-ink);
  }

  .mp-spot-zone {
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--color-sm-slate);
  }

  .mp-spot-zone::before {
    content: '↳ ';
  }

  .mp-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    font-size: 0.8125rem;
    color: var(--color-sm-green-dark);
  }

  .mp-spot-note {
    font-size: 0.8125rem;
    font-style: italic;
    line-height: 1.5;
    color: var(--color-sm-slate);
  }

  /* ------------------------------------------------------- the studios --- */

  .mp-studios {
    margin-top: 3.25rem;
  }

  .mp-studio-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 0.4rem;
    margin-top: 1.1rem;
  }

  /* The studio's own colour as a spine down the left, rather than behind the
     name or around the card. Fourteen colours is a lot to put on one page: as
     a 3px rule each one identifies its row without any of them competing with
     the badge beside it, which is where the colour is actually doing work. */
  .mp-studio {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 0.75rem;
    border-left: 3px solid var(--studio);
    border-radius: 0 9px 9px 0;
    background: var(--color-sm-mist);
  }

  .mp-badge {
    flex: 0 0 auto;
  }

  .mp-studio-body {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
    min-width: 0;
  }

  .mp-studio-name {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-sm-ink);
  }

  .mp-studio-where {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: var(--color-sm-slate);
  }

  /* The floor rides with each place rather than being said once: two of these
     studios are on both floors, so one line underneath would be wrong. */
  .mp-studio-where i {
    font-family: var(--font-display);
    font-size: 0.62rem;
    font-style: normal;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    opacity: 0.65;
  }

  /* A studio with nowhere to send anybody is the one thing this page cannot do
     its job without, so it says so in the alert colour and keeps its place in
     the list rather than being filtered to a footnote. */
  .mp-studio.is-homeless {
    border-left-color: var(--color-sm-line);
  }

  .mp-studio.is-homeless .mp-badge {
    opacity: 0.4;
  }

  .mp-studio.is-homeless .mp-studio-where {
    font-weight: 600;
    color: var(--color-sm-alert);
  }

  .mp-todo {
    margin-top: 3rem;
    padding: 1.1rem 1.25rem;
    background: var(--color-sm-mist);
    border-left: 4px solid var(--color-sm-green-mid);
    border-radius: 0 10px 10px 0;
  }

  .mp-todo h2 {
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-sm-slate);
  }

  .mp-todo ul {
    display: grid;
    gap: 0.45rem;
  }

  .mp-todo li {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-sm-ink-2);
  }

  .mp-undrawn {
    margin-top: 1rem;
    font-size: 0.8125rem;
    color: var(--color-sm-slate);
  }

  .mp-note {
    max-width: 62ch;
    margin-top: 2.5rem;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-sm-slate);
  }

  @media (max-width: 40rem) {
    /* The plan is the one thing here that cannot usefully shrink any further,
       so at phone width it gets the sheet's own gutters back. */
    .mp-plan-wrap {
      margin: 0 calc(var(--pad-x) * -1);
      padding: 0.6rem;
      border-radius: 0;
    }

    .mp-spots,
    .mp-studio-list {
      grid-template-columns: 1fr;
    }
  }
</style>
